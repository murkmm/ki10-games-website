---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Press Coverage',
  description: 'Ki10 Games in the news. Read independent coverage of The One Bullet Job and our other games.',
};

const coverage = [
  {
    outlet: 'The Game Scorecard',
    title: 'The One Bullet Job',
    game: 'The One Bullet Job',
    summary: 'The Game Scorecard’s review page for The One Bullet Job.',
    href: 'https://thegamescorecard.com/game/the_one_bullet_job',
  },
  {
    outlet: 'Androiduj.cz',
    title: 'The One Bullet Job míří na Android: Naplánujte dokonalou loupež s jediným nábojem',
    date: '22 October 2026',
    game: 'The One Bullet Job',
    summary:
      'A Czech look at the game: plan the perfect bank job with a single bullet, across 120 levels plus daily heists and leaderboards.',
    href: 'https://www.androiduj.cz/the-one-bullet-job-miri-na-android-naplanujte-dokonalou-loupez-s-jedinym-nabojem/',
  },
  {
    outlet: 'DroidGamers',
    title: 'The One Bullet Job Is a Turn-Based Heist Puzzle with Grids, Out Now',
    date: 'October 2026',
    game: 'The One Bullet Job',
    summary:
      'A launch write-up covering the fixed guard routes, the three-star scoring and the 20 chapters, from the bank to the casino.',
    href: 'https://www.droidgamers.com/news/the-one-bullet-job/',
  },
  {
    outlet: 'Pocket Gamer',
    title: 'The One Bullet Job is a heist puzzler where you only get one shot. Literally.',
    date: '13 October 2026',
    game: 'The One Bullet Job',
    summary: 'A preview of our turn-based heist puzzler and its one-bullet twist.',
    href: 'https://www.pocketgamer.com/the-one-bullet-job/coming-to-android/',
  },
  {
    outlet: 'GamingonPhone',
    title: 'The One Bullet Job is a turn-based heist puzzle game launching on Android this October 16',
    date: '13 October 2026',
    game: 'The One Bullet Job',
    summary: 'A look at the 120 puzzles, guard patrols, daily heists and unlockable crew cosmetics.',
    href: 'https://gamingonphone.com/news/the-one-bullet-job-is-a-turn-based-heist-puzzle-game-launching-on-android-this-october-16/',
  },
];
---

<Layout metadata={metadata}>
  <div class="ki10-container py-10 md:py-14">
    <header class="max-w-3xl">
      <span class="ki10-kicker">
        <Icon name="tabler:news" class="h-4 w-4" />
        In the news
      </span>
      <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl">Press coverage</h1>
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        It’s always lovely seeing someone write about our games. Here are the articles and reviews we’ve spotted so far.
      </p>
    </header>

    <section class="mt-10 grid gap-5 md:grid-cols-2">
      {
        coverage.map((article) => (
          <article class="ki10-card ki10-card-interactive group relative flex flex-col p-6">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-bold uppercase tracking-wider text-muted">
              <span>{article.date ? `${article.outlet} · ${article.date}` : article.outlet}</span>
              <span class="rounded-md bg-subtle px-2 py-0.5 text-[0.7rem] text-secondary">{article.game}</span>
            </div>
            <h2 class="mt-3 font-heading text-xl font-extrabold leading-snug text-heading group-hover:text-secondary">
              <a
                href={article.href}
                target="_blank"
                rel="noopener noreferrer"
                class="after:absolute after:inset-0 after:content-['']"
              >
                {article.title}
              </a>
            </h2>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{article.summary}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-bold text-secondary">
              Read article
              <Icon name="tabler:external-link" class="h-4 w-4" />
            </span>
          </article>
        ))
      }
    </section>

    <div class="ki10-panel mt-10 flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center">
      <p class="text-sm text-muted">
        Writing about one of our games? Grab logos, screenshots and trailers from our press kit, or email us directly.
      </p>
      <div class="flex flex-shrink-0 flex-wrap gap-3">
        <a href="/press" class="btn-primary text-sm">Open press kit</a>
        <a href="/contact" class="btn-secondary text-sm">Get in touch</a>
      </div>
    </div>
  </div>
</Layout>
