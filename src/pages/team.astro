---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import markPhoto from '~/assets/images/team-mark.webp';
import scottPhoto from '~/assets/images/team-scott.webp';

const metadata = {
  title: 'Team',
  description:
    'Meet the two people behind Ki10 Games: Mark McManus on design, programming and QA, Scott Hamilton on art and world building.',
};

const team = [
  {
    name: 'Mark McManus',
    role: 'Design, Programming & QA',
    photo: markPhoto,
    slug: 'mark',
    bio: [
      'Mark is the games industry veteran of the team, with 10+ years of experience making sure other people’s games are as polished as they are fun at studios like Supermassive Games, Creative Assembly and Unity. Now he’s setting off on a journey to make his own mark on the industry.',
      'At Ki10 he handles game design, programming and QA. He built Skill Check, The One Bullet Job and Save File 0, works on systems and feel for Boop n Burn and KIT, and writes most of the devlogs — including the one about how a childhood hospital stay and a copy of Crash Bandicoot started all of this.',
    ],
    focus: ['Game design', 'Programming', 'QA & polish', 'Devlogs'],
  },
  {
    name: 'Scott Hamilton',
    role: 'Art & World Building',
    photo: scottPhoto,
    slug: 'scott',
    bio: [
      'Scott is our resident artist and brings his wonderfully unique art style to our games. He’s been playing games since he was young and always dreamt of making them — now he’s pitching in wherever he can to give everything we build its own distinct look.',
      'From characters and environments to logos and UI, Scott helps bring our ideas to life, and he’s also behind some of our favourite additions — including KIT’s creature garden.',
    ],
    focus: ['Character & concept art', 'Environment art', '3D modelling', 'Logo & UI design'],
  },
];

const workingNotes = [
  {
    title: 'Wearing many hats',
    description:
      'With a two-person studio, you don’t get to stay in one lane. We both jump into whatever a project needs and pick up new skills along the way.',
    icon: 'tabler:users',
  },
  {
    title: 'Actually finishing games',
    description:
      'Building and releasing Skill Check and The One Bullet Job taught us way more about shipping real games than endlessly polishing one prototype ever could.',
    icon: 'tabler:target-arrow',
  },
  {
    title: 'Sharing the journey',
    description:
      'We write our devlogs as we go — the wins, the bugs, and the pivots — so anyone following along can see how our games actually come together.',
    icon: 'tabler:writing',
  },
];
---

<Layout metadata={metadata}>
  <div class="ki10-container py-10 md:py-14">
    <header class="max-w-3xl">
      <span class="ki10-kicker">
        <Icon name="tabler:users" class="h-4 w-4" />
        The team
      </span>
      <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl">
        Two people, one studio
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        We’ve been friends for years. Ki10 Games started when we stopped talking about making games and actually had a
        go.
      </p>
    </header>

    <section class="mt-10 grid gap-6 md:grid-cols-2">
      {
        team.map((member) => (
          <article class="ki10-card flex flex-col p-6 sm:p-7">
            <div class="flex items-center gap-4">
              <Image
                src={member.photo}
                alt={member.name}
                width={80}
                height={80}
                loading="eager"
                class="h-16 w-16 flex-shrink-0 rounded-2xl border-2 border-primary/40 object-cover"
              />
              <div>
                <h2 class="font-heading text-2xl font-extrabold leading-tight tracking-tight text-heading">
                  {member.name}
                </h2>
                <p class="mt-0.5 text-xs font-bold uppercase tracking-wider text-secondary">{member.role}</p>
              </div>
            </div>

            <div class="mt-5 space-y-3 text-sm leading-relaxed text-muted sm:text-base">
              {member.bio.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>

            <ul class="mt-5 flex flex-wrap gap-2">
              {member.focus.map((item) => (
                <li class="rounded-lg bg-subtle px-2.5 py-1 text-xs font-semibold text-default">{item}</li>
              ))}
            </ul>

            <div class="mt-auto border-t border-ink pt-5">
              <a
                href={`/author/${member.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-bold text-secondary hover:underline"
              >
                Devlogs by {member.name.split(' ')[0]}
                <Icon name="tabler:arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <section class="mt-12">
      <div class="ki10-panel p-6 sm:p-8">
        <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading">How we work</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {
            workingNotes.map((note) => (
              <div>
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/15 text-primary dark:text-accent">
                  <Icon name={note.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-3 font-heading text-lg font-bold text-heading">{note.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{note.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mt-12">
      <div class="ki10-card flex flex-col items-start justify-between gap-6 p-6 sm:flex-row sm:items-center sm:p-8">
        <div class="max-w-xl">
          <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading">Say hello</h2>
          <p class="mt-1.5 text-muted">
            Got a question, want to chat about a game, or interested in working together? Drop us a message — we read
            everything.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">
            <Icon name="tabler:mail" class="h-4 w-4" />
            Get in touch
          </a>
          <a href="/devlog" class="btn-secondary">
            <Icon name="tabler:notebook" class="h-4 w-4" />
            Read the devlog
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
