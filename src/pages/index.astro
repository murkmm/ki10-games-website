---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import teamTogether from '~/assets/images/team-together.webp';
import bnbShipyard from '~/assets/images/bnb-shipyard.webp';
import objHero from '~/assets/images/obj-hero.webp';
import skillcheckHero from '~/assets/images/skillcheck-hero.webp';
import kitGodotVista from '~/assets/images/kit-godot-vista.webp';
import { getGame, statusLabels } from '~/data/games';
import { friends } from '~/data/friends';
import { studio } from '~/data/studio';
import { findLatestPosts } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

interface HeroSlide {
  slug: string;
  title: string;
  eyebrow: string;
  tagline: string;
  accent: string;
  primaryCta: { label: string; href: string; external?: boolean; icon: string };
  secondaryCta?: { label: string; href: string; external?: boolean; icon?: string };
  video?: string;
  poster?: string;
  image?: ImageMetadata;
  logo?: string;
  logoAlt?: string;
  pixelArt?: boolean;
  hideHeadline?: boolean;
}

const sf0 = getGame('save-file-0')!;
const bnb = getGame('boop-n-burn')!;
const obj = getGame('the-one-bullet-job')!;
const sc = getGame('skill-check')!;
const kit = getGame('kit-knight-in-training')!;

const heroSlides: HeroSlide[] = [
  {
    slug: sf0.slug,
    title: sf0.title,
    eyebrow: 'Game Boy Color · Survival Horror · Real Cartridge',
    tagline: sf0.tagline,
    accent: '#5ee88d',
    video: '/videos/sf0-teaser.mp4',
    poster: '/videos/sf0-teaser-poster.png',
    logo: '/press/save-file-0/save-file-0-logo-transparent.png',
    logoAlt: 'Save File 0',
    pixelArt: true,
    primaryCta: { label: 'Explore Save File 0', href: `/projects/${sf0.slug}`, icon: 'tabler:arrow-right' },
    secondaryCta: {
      label: 'Watch trailer',
      href: 'https://youtu.be/nbiv6W50Lho',
      external: true,
      icon: 'tabler:player-play-filled',
    },
  },
  {
    slug: bnb.slug,
    title: bnb.title,
    eyebrow: '16-Player Party Brawler · Steam Next Fest Feb 2027',
    tagline: bnb.tagline,
    accent: '#ff7a3d',
    video: '/videos/bnb-hero.mp4',
    poster: bnbShipyard.src,
    primaryCta: { label: 'Explore Boop n Burn', href: `/projects/${bnb.slug}`, icon: 'tabler:arrow-right' },
    secondaryCta: { label: 'Get demo updates', href: '/contact#newsletter', icon: 'tabler:mail' },
  },
  {
    slug: obj.slug,
    title: obj.title,
    eyebrow: 'Out Now · Free on Android · Heist Puzzle',
    tagline: obj.tagline,
    accent: '#f5b82e',
    video: '/videos/obj-hero.mp4',
    poster: objHero.src,
    logo: '/press/the-one-bullet-job/obj-logo.png',
    logoAlt: 'The One Bullet Job',
    primaryCta: {
      label: 'Get it on Google Play',
      href: 'https://play.google.com/store/apps/details?id=com.ki10games.onebulletjob',
      external: true,
      icon: 'tabler:brand-google-play',
    },
    secondaryCta: { label: 'Explore the game', href: `/projects/${obj.slug}`, icon: 'tabler:arrow-right' },
  },
  {
    slug: sc.slug,
    title: sc.title,
    eyebrow: 'Out Now · Free on Web & Android · Daily Trivia',
    tagline: sc.tagline,
    accent: '#e879f9',
    image: skillcheckHero,
    primaryCta: {
      label: 'Play in your browser',
      href: 'https://skillcheckgame.com/',
      external: true,
      icon: 'tabler:world',
    },
    secondaryCta: { label: 'Explore Skill Check', href: `/projects/${sc.slug}`, icon: 'tabler:arrow-right' },
  },
  {
    slug: kit.slug,
    title: kit.title,
    eyebrow: 'In Development · PC · 3D Action Adventure',
    tagline: kit.tagline,
    accent: '#38bdf8',
    video: '/videos/kit-highlight.mp4',
    poster: kitGodotVista.src,
    primaryCta: { label: 'Explore KIT', href: `/projects/${kit.slug}`, icon: 'tabler:arrow-right' },
    secondaryCta: { label: 'Read the KIT devlogs', href: '/tag/kit', icon: 'tabler:notebook' },
  },
];

const latestRaw = await findLatestPosts({ count: 2 });
const latestPosts = await Promise.all(
  latestRaw.map(async (post) => ({
    ...post,
    resolvedImage: (await findImage(post.image)) as ImageMetadata | undefined,
  }))
);

const pressOutlets = ['Pocket Gamer', 'DroidGamers', 'GamingonPhone', 'The Game Scorecard'];

const metadata = {
  title: 'Ki10 Games — Indie Game Studio',
  ignoreTitleTemplate: true,
  description:
    'Games from a two-person independent studio in the UK. Play The One Bullet Job and Skill Check, and discover Save File 0, Boop n Burn and KIT: Knight in Training.',
};
---

<Layout metadata={metadata}>
  <StructuredData />

  <!-- =====================================================================
       1. FULL-BLEED CINEMATIC GAME SHOWCASE STAGE
          Inspired by Supergiant, Devolver & Playtonic: art & gameplay first.
       ===================================================================== -->
  <section class="hero-stage relative overflow-hidden bg-[#0c0d11] text-white" aria-label="Featured Ki10 Games">
    <div class="relative min-h-[520px] sm:min-h-[600px] lg:min-h-[650px]">
      {
        heroSlides.map((slide, index) => (
          <div
            data-hero-slide={index}
            aria-hidden={index === 0 ? 'false' : 'true'}
            class:list={[
              'hero-slide absolute inset-0 flex flex-col justify-end transition-opacity duration-700',
              index === 0 ? 'z-10 opacity-100' : 'pointer-events-none z-0 opacity-0',
            ]}
          >
            {/* Full-bleed video or key art */}
            <div class="absolute inset-0 overflow-hidden bg-[#0c0d11]">
              {slide.video ? (
                <video
                  autoplay={index === 0}
                  loop
                  muted
                  playsinline
                  preload={index === 0 ? 'auto' : 'metadata'}
                  poster={slide.poster}
                  class:list={[
                    'h-full w-full object-cover object-center opacity-85',
                    { 'pixel-art': slide.pixelArt },
                  ]}
                >
                  <source src={slide.video} type="video/mp4" />
                </video>
              ) : (
                slide.image && (
                  <Image
                    src={slide.image}
                    alt={`Key art for ${slide.title}`}
                    widths={[800, 1400, 1920]}
                    sizes="100vw"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    class:list={[
                      'h-full w-full object-cover',
                      slide.slug === 'the-one-bullet-job' ? 'object-right-top sm:object-right' : 'object-center',
                    ]}
                  />
                )
              )}

              {/* Smooth cinematic gradient mask for effortless readability */}
              <div
                class="absolute inset-0 bg-gradient-to-t from-[#0c0d11] via-[#0c0d11]/55 to-[#0c0d11]/25"
                aria-hidden="true"
              />
              <div
                class="absolute inset-0 bg-gradient-to-r from-[#0c0d11]/95 via-[#0c0d11]/55 to-transparent"
                aria-hidden="true"
              />
            </div>

            {/* Clean, clutter-free Foreground Content */}
            <div class="ki10-container relative z-10 pb-24 pt-12 sm:pb-32 sm:pt-20 md:pb-36">
              <div class="max-w-xl">
                <p
                  class="text-[0.7rem] font-extrabold uppercase tracking-[0.14em] sm:text-xs sm:tracking-[0.16em]"
                  style={`color: ${slide.accent};`}
                >
                  {slide.eyebrow}
                </p>

                {slide.logo ? (
                  <div class="mt-3 sm:mt-4">
                    <h2 class="sr-only">{slide.title}</h2>
                    <img
                      src={slide.logo}
                      alt={slide.logoAlt ?? slide.title}
                      class:list={[
                        'h-auto w-auto max-w-[215px] object-contain drop-shadow-[0_6px_24px_rgba(0,0,0,0.8)] sm:max-w-[340px]',
                        slide.pixelArt ? 'pixel-art max-h-[96px] sm:max-h-[135px]' : 'max-h-[86px] sm:max-h-[115px]',
                      ]}
                    />
                  </div>
                ) : (
                  <h2 class="mt-3 font-heading text-3xl font-extrabold leading-[1.04] tracking-tight text-white drop-shadow sm:text-5xl lg:text-6xl">
                    {slide.title}
                  </h2>
                )}

                <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/85 sm:mt-4 sm:text-lg">{slide.tagline}</p>

                <div class="mt-5 flex flex-wrap items-center gap-2.5 sm:mt-7 sm:gap-3">
                  <a
                    href={slide.primaryCta.href}
                    target={slide.primaryCta.external ? '_blank' : undefined}
                    rel={slide.primaryCta.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-extrabold text-[#0c0d11] transition hover:brightness-110 sm:px-5 sm:py-3 sm:text-base"
                    style={`background-color: ${slide.accent};`}
                  >
                    <Icon name={slide.primaryCta.icon} class="h-4 w-4" />
                    {slide.primaryCta.label}
                  </a>

                  {slide.secondaryCta && (
                    <a
                      href={slide.secondaryCta.href}
                      target={slide.secondaryCta.external ? '_blank' : undefined}
                      rel={slide.secondaryCta.external ? 'noopener noreferrer' : undefined}
                      class="inline-flex items-center gap-2 rounded-xl border border-white/25 bg-white/10 px-4 py-2.5 text-sm font-bold text-white backdrop-blur-sm transition hover:border-white/50 hover:bg-white/20 sm:px-5 sm:py-3 sm:text-base"
                    >
                      {slide.secondaryCta.icon && <Icon name={slide.secondaryCta.icon} class="h-4 w-4" />}
                      {slide.secondaryCta.label}
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }

      {/* Desktop/Tablet Side Chevrons */}
      <div class="pointer-events-none absolute inset-y-0 left-0 right-0 z-20 hidden items-center justify-between px-3 md:flex lg:px-5">
        <button
          type="button"
          data-hero-prev
          aria-label="Previous game"
          class="pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-black/45 text-white/80 backdrop-blur-sm transition hover:border-white/40 hover:bg-black/70 hover:text-white"
        >
          <Icon name="tabler:chevron-left" class="h-5 w-5" />
        </button>
        <button
          type="button"
          data-hero-next
          aria-label="Next game"
          class="pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-black/45 text-white/80 backdrop-blur-sm transition hover:border-white/40 hover:bg-black/70 hover:text-white"
        >
          <Icon name="tabler:chevron-right" class="h-5 w-5" />
        </button>
      </div>

      {/* Responsive Switcher Dock: clean progress bar + Prev/Next on mobile, 5-column storefront tabs on md+ */}
      <div class="absolute bottom-0 left-0 right-0 z-20 border-t border-white/10 bg-[#0c0d11]/85 backdrop-blur-md">
        <div class="ki10-container">
          {/* Mobile Dock (< 768px): zero text collision, full touch controls */}
          <div class="py-2.5 md:hidden">
            <div class="grid grid-cols-5 gap-1.5" role="tablist" aria-label="Featured game progress">
              {
                heroSlides.map((slide, index) => (
                  <button
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-label={`Show ${slide.title}`}
                    data-hero-tab={index}
                    data-hero-title={slide.slug === 'kit-knight-in-training' ? 'KIT' : slide.title}
                    style={`--tab-accent: ${slide.accent};`}
                    class:list={[
                      'hero-tab group relative py-1.5 text-left',
                      index === 0 ? 'is-active' : '',
                    ]}
                  >
                    <span class="hero-tab-bar block h-[3px] w-full overflow-hidden rounded-full bg-white/15">
                      <span class="hero-tab-fill block h-full w-0 rounded-full" />
                    </span>
                  </button>
                ))
              }
            </div>
            <div class="mt-1.5 flex items-center justify-between gap-2">
              <button
                type="button"
                data-hero-prev
                aria-label="Previous game"
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/15 bg-white/5 text-white/85 active:bg-white/15"
              >
                <Icon name="tabler:chevron-left" class="h-4 w-4" />
              </button>
              <div class="flex min-w-0 items-center gap-2 text-xs">
                <span data-hero-mobile-count class="shrink-0 font-bold tabular-nums text-white/55">01 / 05</span>
                <span aria-hidden="true" class="text-white/30">·</span>
                <span data-hero-mobile-title class="truncate font-bold text-white">{heroSlides[0].title}</span>
              </div>
              <button
                type="button"
                data-hero-next
                aria-label="Next game"
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/15 bg-white/5 text-white/85 active:bg-white/15"
              >
                <Icon name="tabler:chevron-right" class="h-4 w-4" />
              </button>
            </div>
          </div>

          {/* Desktop / Tablet Dock (>= 768px): 5-column storefront bar with strict truncation */}
          <div class="hidden grid-cols-5 gap-3 md:grid" role="tablist" aria-label="Choose a featured game">
            {
              heroSlides.map((slide, index) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  data-hero-tab={index}
                  data-hero-title={slide.slug === 'kit-knight-in-training' ? 'KIT' : slide.title}
                  style={`--tab-accent: ${slide.accent};`}
                  class:list={[
                    'hero-tab group relative flex min-w-0 w-full flex-col items-start overflow-hidden py-4 text-left transition',
                    index === 0 ? 'is-active text-white' : 'text-white/55 hover:text-white/85',
                  ]}
                >
                  <span class="hero-tab-bar absolute left-0 right-0 top-0 h-[3px] bg-white/10">
                    <span class="hero-tab-fill block h-full w-0" />
                  </span>
                  <span class="text-[0.65rem] font-bold uppercase tracking-widest opacity-60">
                    0{index + 1}
                  </span>
                  <span class="mt-0.5 block w-full truncate text-sm font-bold">
                    {slide.slug === 'kit-knight-in-training' ? 'KIT' : slide.title}
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       2. STUDIO INTRO & LIVE WORKSHOP NOTE (Clean, Spacious, Zero Clutter)
       ===================================================================== -->
  <section class="border-b border-ink bg-page py-12 md:py-16" aria-labelledby="studio-title">
    <div class="ki10-container">
      <div class="grid items-center gap-8 lg:grid-cols-[1.25fr_0.95fr] lg:gap-14">
        <div>
          <p class="ki10-kicker">Ki10 Games (pronounced “Kitten”) · United Kingdom</p>
          <h1
            id="studio-title"
            class="mt-3 font-heading text-3xl font-extrabold leading-tight tracking-tight text-heading sm:text-4xl lg:text-5xl"
          >
            Two friends making the games we want to play.
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
            Hi, we’re Mark and Scott — two friends making games in the UK. Our mission is simple: we make the games we’d
            personally want to play and enjoy.
          </p>
        </div>

        <div class="ki10-panel p-5 sm:p-6">
          <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-secondary">
            <Icon name="tabler:hammer" class="h-4 w-4" />
            {studio.currentlyWorkingOn.label}
          </div>
          <p class="mt-2.5 text-sm leading-relaxed text-default sm:text-base">{studio.currentlyWorkingOn.text}</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-ink pt-4 text-xs font-bold">
            <a href="/qa-services" class="inline-flex items-center gap-1.5 text-heading transition hover:text-secondary">
              <Icon name="tabler:bug" class="h-4 w-4 text-mint" />
              Indie QA Testing (from £35)
            </a>
            <a
              href="/press-coverage"
              class="inline-flex items-center gap-1.5 text-heading transition hover:text-secondary"
            >
              <Icon name="tabler:news" class="h-4 w-4 text-secondary" />
              Press coverage
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3. ART-FIRST GAME POSTER GALLERY (All 5 Games)
       ===================================================================== -->
  <section id="our-games" class="ki10-container py-14 md:py-20" aria-labelledby="games-title">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="ki10-kicker">The Catalogue</span>
        <h2 id="games-title" class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-heading sm:text-4xl">
          Our games
        </h2>
      </div>
      <a href="/projects" class="inline-flex items-center gap-1.5 text-sm font-bold text-secondary hover:underline">
        View all games &rarr;
      </a>
    </div>

    <!-- Top Row: Save File 0 (wide flagship box mockup) + Boop n Burn -->
    <div class="grid gap-5 lg:grid-cols-12">
      <a
        href="/projects/save-file-0"
        class="game-poster group relative flex min-h-[320px] flex-col justify-end overflow-hidden rounded-2xl bg-[#0e1214] text-white sm:min-h-[380px] lg:col-span-7"
        style={`--poster-accent: ${sf0.accentDark};`}
      >
        <img
          src="/press/save-file-0/save-file-0-handheld-and-box-mockup-1920x1080.png"
          alt="Save File 0 Game Boy Color handheld, box and cartridge"
          loading="lazy"
          class="pixel-art absolute inset-0 h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0c0d11] via-[#0c0d11]/30 to-transparent"
          aria-hidden="true"
        ></div>
        <div class="relative z-10 p-6 sm:p-7">
          <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider">
            <span class="text-[#5ee88d]">In development</span>
            <span class="text-white/40">·</span>
            <span class="text-white/75">{sf0.platforms.join(' · ')}</span>
          </div>
          <h3 class="mt-1.5 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{sf0.title}</h3>
          <p class="mt-1 max-w-md text-sm text-white/80">{sf0.tagline}</p>
        </div>
      </a>

      <a
        href="/projects/boop-n-burn"
        class="game-poster group relative flex min-h-[320px] flex-col justify-end overflow-hidden rounded-2xl bg-[#1a1210] text-white sm:min-h-[380px] lg:col-span-5"
        style={`--poster-accent: ${bnb.accentDark};`}
      >
        {
          bnb.hero && (
            <Image
              src={bnb.hero}
              alt="Boop n Burn shipping yard arena"
              widths={[500, 900]}
              sizes="(min-width: 1024px) 42vw, 100vw"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          )
        }
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0c0d11] via-[#0c0d11]/35 to-transparent"
          aria-hidden="true"
        ></div>
        <div class="relative z-10 p-6 sm:p-7">
          <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider">
            <span class="text-[#ff9c66]">Demo Feb 2027</span>
            <span class="text-white/40">·</span>
            <span class="text-white/75">{bnb.genre}</span>
          </div>
          <h3 class="mt-1.5 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{bnb.title}</h3>
          <p class="mt-1 text-sm text-white/80">{bnb.tagline}</p>
        </div>
      </a>

      <!-- Bottom Row: The One Bullet Job, Skill Check, KIT -->
      {
        [obj, sc, kit].map((game) => (
          <a
            href={`/projects/${game.slug}`}
            class="game-poster group relative flex min-h-[280px] flex-col justify-end overflow-hidden rounded-2xl bg-[#13141a] text-white sm:min-h-[310px] lg:col-span-4"
            style={`--poster-accent: ${game.accentDark};`}
          >
            {game.card && (
              <Image
                src={game.card}
                alt={`Key art for ${game.title}`}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            )}
            <div
              class="absolute inset-0 bg-gradient-to-t from-[#0c0d11] via-[#0c0d11]/45 to-transparent"
              aria-hidden="true"
            />
            <div class="relative z-10 p-5 sm:p-6">
              <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider">
                <span class={game.status === 'released' ? 'text-[#2dd4bf]' : 'text-white/80'}>
                  {statusLabels[game.status]}
                </span>
                <span class="text-white/40">·</span>
                <span class="text-white/75">{game.platforms.join(' · ')}</span>
              </div>
              <h3 class="mt-1 font-heading text-xl font-extrabold tracking-tight sm:text-2xl">{game.title}</h3>
              <p class="mt-1 line-clamp-2 text-sm text-white/80">{game.tagline}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- =====================================================================
       4. LATEST FROM THE DEVLOG (With Real Cover Art)
       ===================================================================== -->
  {
    latestPosts.length > 0 && (
      <section class="border-y border-ink bg-subtle/50 py-14 md:py-20" aria-labelledby="latest-devlogs-title">
        <div class="ki10-container">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="ki10-kicker">Behind the scenes</span>
              <h2
                id="latest-devlogs-title"
                class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-heading sm:text-4xl"
              >
                Latest devlogs
              </h2>
            </div>
            <div class="flex items-center gap-4 text-sm font-bold">
              <a
                href="/rss.xml"
                class="inline-flex items-center gap-1.5 text-muted transition hover:text-secondary"
                title="RSS feed"
              >
                <Icon name="tabler:rss" class="h-4 w-4" />
                RSS
              </a>
              <a href="/devlog" class="inline-flex items-center gap-1 text-secondary hover:underline">
                All devlogs &rarr;
              </a>
            </div>
          </div>

          <div class="grid gap-6 lg:grid-cols-2">
            {latestPosts.map((post) => (
              <article class="ki10-card ki10-card-interactive group relative flex flex-col overflow-hidden sm:flex-row">
                {post.resolvedImage && (
                  <div class="relative aspect-video w-full flex-shrink-0 overflow-hidden bg-black sm:aspect-auto sm:w-52">
                    <Image
                      src={post.resolvedImage}
                      alt={post.title}
                      widths={[360, 640]}
                      sizes="(min-width: 640px) 220px, 100vw"
                      loading="lazy"
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    />
                  </div>
                )}

                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
                    <time datetime={post.publishDate.toISOString()}>
                      {post.publishDate.toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                        timeZone: 'UTC',
                      })}
                    </time>
                    {post.author && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>By {post.author}</span>
                      </>
                    )}
                    {post.readingTime && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{post.readingTime} min read</span>
                      </>
                    )}
                  </div>

                  <h3 class="mt-2 font-heading text-xl font-extrabold leading-snug text-heading group-hover:text-secondary">
                    <a
                      href={getPermalink(post.permalink, 'post')}
                      class="after:absolute after:inset-0 after:content-['']"
                    >
                      {post.title}
                    </a>
                  </h3>

                  {post.excerpt && (
                    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{post.excerpt}</p>
                  )}

                  <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-bold text-secondary">
                    Read devlog
                    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
                  </span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- =====================================================================
       5. MARK & SCOTT + DISCORD COMMUNITY
       ===================================================================== -->
  <section class="ki10-container py-14 md:py-20" aria-labelledby="story-title">
    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="ki10-card grid items-center gap-6 overflow-hidden p-6 sm:grid-cols-[200px_1fr] sm:p-7">
        <div class="overflow-hidden rounded-xl border border-ink">
          <Image
            src={teamTogether}
            alt="Mark McManus and Scott Hamilton of Ki10 Games"
            widths={[320, 560]}
            sizes="(min-width: 640px) 200px, 100vw"
            loading="lazy"
            class="aspect-square h-full w-full object-cover"
          />
        </div>

        <div>
          <span class="ki10-kicker">Mark &amp; Scott</span>
          <h2 id="story-title" class="mt-2 font-heading text-2xl font-extrabold tracking-tight text-heading sm:text-3xl">
            Two mates trying to sell 10 copies
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
            We’re Mark (design) and Scott (art). Part of why we’re called Ki10 is our original goal of just selling 10
            copies. To get there, we don’t stick to one genre — if we like the sound of an idea and want to play it
            ourselves, we’ll give it a go.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-5 text-sm font-bold">
            <a href="/about" class="text-secondary hover:underline">Our story &rarr;</a>
            <a href="/team" class="text-heading hover:text-secondary hover:underline">Meet the team</a>
          </div>
        </div>
      </div>

      <!-- Atmospheric Berry Discord Card -->
      <div
        class="relative flex flex-col justify-between overflow-hidden rounded-2xl border border-[#ff6aa8]/30 bg-gradient-to-br from-[#9e164e] via-[#c41f64] to-[#1d1424] p-6 text-white sm:p-8"
      >
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-widest text-pink-200">
            <Icon name="tabler:brand-discord" class="h-4 w-4" />
            Community
          </span>
          <h2 class="mt-3 font-heading text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
            Come hang out on Discord
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-white/90 sm:text-base">
            Come talk to us about our games, or tell us what you’ve been playing and working on — we’d love to have you.
          </p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={studio.discordUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-extrabold text-[#14151a] transition hover:bg-pink-50"
          >
            <Icon name="tabler:brand-discord" class="h-5 w-5 text-[#c41f64]" />
            Join our Discord
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-1.5 rounded-xl border border-white/30 bg-white/10 px-4 py-3 text-sm font-bold text-white transition hover:bg-white/20"
          >
            Say hello
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       6. PRESS MENTIONS & FRIENDS OF KI10
       ===================================================================== -->
  <section class="ki10-container pb-14" aria-label="Press coverage and friends of Ki10">
    <div class="space-y-4 border-t border-ink pt-7">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <span class="text-xs font-extrabold uppercase tracking-widest text-muted">Spotted in the press</span>
          {pressOutlets.map((outlet) => <span class="font-heading text-sm font-bold text-heading/80">{outlet}</span>)}
        </div>
        <a href="/press-coverage" class="text-sm font-bold text-secondary hover:underline">
          Read press coverage &rarr;
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-ink pt-5">
        <span class="text-xs font-extrabold uppercase tracking-widest text-muted">Friends of Ki10</span>
        {
          friends.map((friend) => (
            <a
              href={friend.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 rounded-xl border border-ink bg-card px-3.5 py-2 text-sm font-semibold text-heading transition hover:border-primary hover:text-secondary"
            >
              <Image src={friend.logo} alt="" width={32} height={32} loading="lazy" class="h-6 w-6 object-contain" />
              <span>{friend.name}</span>
              <Icon name="tabler:external-link" class="h-3.5 w-3.5 text-muted" />
            </a>
          ))
        }
        <a href="/press" class="text-sm font-bold text-muted transition hover:text-secondary hover:underline sm:ml-auto">
          Need logos or screenshots? Press kit &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-tab.is-active .hero-tab-fill {
    background-color: var(--tab-accent);
    width: 100%;
    animation: heroProgress 7.5s linear forwards;
  }

  .hero-stage:hover .hero-tab.is-active .hero-tab-fill,
  .hero-stage:focus-within .hero-tab.is-active .hero-tab-fill {
    animation-play-state: paused;
  }

  @keyframes heroProgress {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tab.is-active .hero-tab-fill {
      animation: none;
      width: 100%;
    }
  }

  .game-poster {
    border: 1px solid rgb(255 255 255 / 12%);
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 260ms ease;
  }

  .game-poster:hover {
    transform: translateY(-4px);
    border-color: var(--poster-accent);
    box-shadow: 0 22px 44px -18px color-mix(in srgb, var(--poster-accent) 45%, transparent);
  }
</style>

<script is:inline>
  (() => {
    const initHeroStage = () => {
      const stage = document.querySelector('.hero-stage');
      if (!stage || stage.dataset.ready === 'true') return;
      stage.dataset.ready = 'true';

      const slides = Array.from(stage.querySelectorAll('[data-hero-slide]'));
      const tabs = Array.from(stage.querySelectorAll('[data-hero-tab]'));
      const mobileCount = stage.querySelector('[data-hero-mobile-count]');
      const mobileTitle = stage.querySelector('[data-hero-mobile-title]');
      if (!slides.length || !tabs.length) return;

      let active = 0;
      let timer = null;
      let paused = false;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const setActive = (nextIndex) => {
        active = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, idx) => {
          const isCurrent = idx === active;
          slide.classList.toggle('opacity-100', isCurrent);
          slide.classList.toggle('z-10', isCurrent);
          slide.classList.toggle('opacity-0', !isCurrent);
          slide.classList.toggle('z-0', !isCurrent);
          slide.classList.toggle('pointer-events-none', !isCurrent);
          slide.setAttribute('aria-hidden', String(!isCurrent));

          const video = slide.querySelector('video');
          if (video) {
            if (isCurrent && !reducedMotion) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        });

        let activeTitle = '';
        tabs.forEach((tab) => {
          const idx = Number(tab.getAttribute('data-hero-tab'));
          const isCurrent = idx === active;
          tab.classList.toggle('is-active', isCurrent);
          tab.classList.toggle('text-white', isCurrent);
          tab.classList.toggle('text-white/55', !isCurrent);
          tab.setAttribute('aria-selected', String(isCurrent));
          if (isCurrent && !activeTitle) {
            activeTitle = tab.getAttribute('data-hero-title') || '';
          }

          // Restart the CSS progress animation cleanly when switching tabs
          const fill = tab.querySelector('.hero-tab-fill');
          if (fill && isCurrent) {
            fill.style.animation = 'none';
            void fill.offsetWidth;
            fill.style.animation = '';
          }
        });

        if (mobileCount) {
          mobileCount.textContent = `0${active + 1} / 0${slides.length}`;
        }
        if (mobileTitle && activeTitle) {
          mobileTitle.textContent = activeTitle;
        }
      };

      const startCycle = () => {
        if (reducedMotion) return;
        window.clearInterval(timer);
        timer = window.setInterval(() => {
          if (!paused) setActive(active + 1);
        }, 7500);
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = Number(tab.getAttribute('data-hero-tab'));
          setActive(idx);
          startCycle();
        });
      });

      stage.querySelectorAll('[data-hero-prev]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setActive(active - 1);
          startCycle();
        });
      });
      stage.querySelectorAll('[data-hero-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setActive(active + 1);
          startCycle();
        });
      });

      // Touch swipe navigation on mobile
      let touchStartX = 0;
      let touchStartY = 0;
      stage.addEventListener(
        'touchstart',
        (event) => {
          if (event.touches.length !== 1) return;
          touchStartX = event.touches[0].clientX;
          touchStartY = event.touches[0].clientY;
        },
        { passive: true }
      );
      stage.addEventListener(
        'touchend',
        (event) => {
          if (!event.changedTouches.length) return;
          const dx = event.changedTouches[0].clientX - touchStartX;
          const dy = event.changedTouches[0].clientY - touchStartY;
          if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) {
            setActive(dx < 0 ? active + 1 : active - 1);
            startCycle();
          }
        },
        { passive: true }
      );

      stage.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          setActive(active - 1);
          startCycle();
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          setActive(active + 1);
          startCycle();
        }
      });

      stage.addEventListener('mouseenter', () => {
        paused = true;
      });
      stage.addEventListener('mouseleave', () => {
        paused = false;
      });
      stage.addEventListener('focusin', () => {
        paused = true;
      });
      stage.addEventListener('focusout', () => {
        paused = false;
      });

      startCycle();
    };

    initHeroStage();
    document.addEventListener('astro:after-swap', initHeroStage);
  })();
</script>
