---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import GameCard from '~/components/games/GameCard.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { games } from '~/data/games';

const metadata = {
  title: 'Ki10 Games, a two person game studio in the UK',
  ignoreTitleTemplate: true,
  description:
    'Ki10 Games is a two person independent studio in the UK. Makers of Skill Check, currently building the party brawler Boop n Burn.',
};
---

<Layout metadata={metadata}>
  <StructuredData />

  <section class="relative overflow-hidden">
    {/* A soft ember glow behind the type, so the text-led hero still has some heat to it. */}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute left-1/2 top-0 h-[36rem] w-[72rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-gradient-to-br from-amber-400/25 via-orange-500/20 to-rose-500/10 blur-3xl dark:from-amber-500/15 dark:via-orange-600/15 dark:to-rose-600/10"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-5xl px-4 pb-10 pt-16 text-center md:px-6 md:pb-14 md:pt-24">
      <p class="text-sm font-bold uppercase tracking-widest text-secondary">Independent studio · United Kingdom</p>

      <h1 class="mt-5 font-heading text-4xl font-bold leading-tight tracking-tighter md:text-6xl">
        Two friends making the games <span class="text-primary dark:text-accent">we</span> want to play.
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-xl text-muted">
        We're a two person studio with a very modest goal, and a name to match: sell ten copies. We don't chase trends
        and we don't stick to one genre. If it sounds fun to us, we'll build it.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button variant="primary" href="/projects/boop-n-burn" icon="tabler:flame">See what we're building</Button>
        <Button href="/projects/skill-check" icon="tabler:device-gamepad-2">Play Skill Check</Button>
      </div>

      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-muted">
        <Icon name="tabler:point-filled" class="h-4 w-4 text-emerald-500" />
        <span><strong class="font-semibold text-default">Skill Check</strong> is out now on Android and web</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 pt-4 md:px-6 md:pb-16 md:pt-6">
    <div class="mb-10 flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-secondary">Our games</p>
        <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight md:text-4xl">One shipped, one in the oven</h2>
      </div>
      <a href="/projects" class="text-sm font-semibold text-primary hover:underline dark:text-accent">
        All games &rarr;
      </a>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {games.map((game, index) => <GameCard game={game} loading={index === 0 ? 'eager' : 'lazy'} />)}
    </div>
  </section>

  <Features
    id="studio"
    tagline="About Ki10"
    title="Our grand plan? To sell ten copies."
    subtitle="Anything past that is a bonus. It keeps us honest about why we're doing this."
    columns={3}
    items={[
      {
        title: 'Friends first, devs second',
        description:
          'Ki10 Games was founded by Scott and Mark after years of friendship and a shared love of making games. We figured it was finally time to make it official.',
        icon: 'tabler:users',
      },
      {
        title: 'Jack of all trades',
        description:
          'There are two of us, so we both end up with a hand in most areas of development. The goal is to unlock the "Jack of All Trades" achievement in life.',
        icon: 'tabler:tools',
      },
      {
        title: 'No genre is safe',
        description:
          'A daily trivia game and a floor is lava party brawler have almost nothing in common, and honestly that’s the point.',
        icon: 'tabler:dice',
      },
    ]}
  />

  <BlogLatestPosts
    title="Latest from the devlog"
    information="We write up the wins, the rewrites and the mistakes as we go. No marketing gloss, just what we actually got done."
  />

  <Features
    id="team"
    tagline="Meet the team"
    title="The minds behind the madness"
    columns={2}
    items={[
      {
        title: 'Mark McManus',
        description:
          'The QA veteran and game designer of the two of us, with nearly a decade spent making sure games are as polished as they are fun.',
        icon: 'tabler:user-edit',
        callToAction: { text: 'More about the team', href: '/team' },
      },
      {
        title: 'Scott Hamilton',
        description:
          'The lead artist and world builder, who turns all the daft ideas into things you can actually look at.',
        icon: 'tabler:palette',
        callToAction: { text: 'More about the team', href: '/team' },
      },
    ]}
  />

  <CallToAction>
    <Fragment slot="title">Follow our journey</Fragment>
    <Fragment slot="subtitle">
      Be the first to hear about new updates, release dates and behind the scenes bits from Ki10 Games.
    </Fragment>

    <Fragment slot="actions">
      <div id="mc_embed_signup">
        <form
          action="https://ki10games.us4.list-manage.com/subscribe/post?u=95a2806341f85cb6e7b58cab0&id=67ed6c3e3d&v_id=73&f_id=00b021e1f0"
          method="post"
          id="mc-embedded-subscribe-form"
          name="mc-embedded-subscribe-form"
          class="validate"
        >
          <div id="mc_embed_signup_scroll">
            <div class="mc-field-group">
              <label for="mce-EMAIL" class="sr-only">Email address</label>
              <input
                type="email"
                name="EMAIL"
                class="required email"
                id="mce-EMAIL"
                required
                value=""
                placeholder="Your email address"
              />
            </div>
            <div id="mergeRow-gdpr" class="mergeRow gdpr-mergeRow content__gdprBlock mc-field-group">
              <div class="content__gdpr">
                <p class="text-sm !text-muted">
                  We'll use your email to send you updates. Please let us know how you'd like to hear from us:
                </p>
                <fieldset class="mc_fieldset gdprRequired mc-field-group" name="interestgroup_field">
                  <label class="checkbox subfield" for="gdpr_43380">
                    <input type="checkbox" id="gdpr_43380" name="gdpr[43380]" class="gdpr" value="Y" />
                    <span>Dev Logs & Studio News</span>
                  </label>
                </fieldset>
              </div>
            </div>
            <div id="mce-responses" class="clear foot">
              <div class="response" id="mce-error-response" style="display: none;"></div>
              <div class="response" id="mce-success-response" style="display: none;"></div>
            </div>
            <div aria-hidden="true" style="position: absolute; left: -5000px;">
              <input type="text" name="b_95a2806341f85cb6e7b58cab0_67ed6c3e3d" tabindex="-1" value="" />
            </div>
            <div class="optionalParent">
              <div class="clear foot">
                <input
                  type="submit"
                  name="subscribe"
                  id="mc-embedded-subscribe"
                  class="btn btn-primary"
                  value="Get Updates"
                />
              </div>
            </div>
          </div>
        </form>
      </div>
    </Fragment>
  </CallToAction>
</Layout>
