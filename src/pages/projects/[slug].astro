---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import GameArt from '~/components/games/GameArt.astro';
import StatusBadge from '~/components/games/StatusBadge.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { Image } from 'astro:assets';
import { games } from '~/data/games';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export async function getStaticPaths() {
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;

const posts = game.devlogTag
  ? (await fetchPosts()).filter((post) => post.tags?.some((tag) => tag.slug === game.devlogTag)).slice(0, 3)
  : [];

const facts = [
  { label: 'Status', value: game.releaseLine, icon: 'tabler:progress' },
  { label: 'Genre', value: game.genre, icon: 'tabler:category' },
  { label: 'Platforms', value: game.platforms.join(' · '), icon: 'tabler:device-gamepad-2' },
  { label: 'Engine', value: game.engine, icon: 'tabler:tools' },
];

// A released game shouldn't be asking people to wait for it, and a paused one
// shouldn't imply a release date we don't have.
const ctaCopy = {
  released: {
    title: 'More where that came from',
    subtitle: 'We post development updates as we go, and the mailing list hears about new releases first.',
  },
  'in-development': {
    title: "Want to know when it's ready?",
    subtitle: 'We post development updates as we go, and the mailing list gets release dates first.',
  },
  'on-hold': {
    title: 'Want to know if it comes back?',
    subtitle:
      "This one is paused, not cancelled. If it starts moving again, the devlog and the mailing list are where you'll hear about it first.",
  },
};
const cta = ctaCopy[game.status];

const metadata = {
  title: game.title,
  description: game.tagline,
  // The game's art makes a better link preview than the studio card. findImage accepts ImageMetadata here.
  openGraph: { type: 'website', images: game.hero ? [{ url: game.hero as unknown as string }] : undefined },
};
---

<Layout metadata={metadata}>
  <StructuredData game={game} />

  <section class="mx-auto max-w-6xl px-4 pt-8 md:px-6 md:pt-12">
    <a
      href="/projects"
      class="inline-flex items-center gap-1 text-sm font-medium text-muted transition hover:text-primary dark:hover:text-accent"
    >
      <Icon name="tabler:chevron-left" class="h-4 w-4" />
      All games
    </a>

    <div class="mt-6 grid items-center gap-10 lg:grid-cols-2">
      <div>
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <StatusBadge status={game.status} />
          <span class="text-sm font-medium uppercase tracking-wide text-muted">{game.genre}</span>
        </div>

        <h1 class="font-heading text-4xl font-bold leading-tight tracking-tighter md:text-5xl">{game.title}</h1>
        <p class="mt-3 text-xl font-medium text-secondary">{game.tagline}</p>
        <p class="mt-5 text-lg text-muted">{game.pitch}</p>

        {
          game.links.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3">
              {game.links.map((link) => (
                <Button
                  variant={link.isPrimary ? 'primary' : 'secondary'}
                  href={link.href}
                  icon={link.icon}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                >
                  {link.label}
                </Button>
              ))}
            </div>
          )
        }
        {
          game.slug === 'boop-n-burn' && (
            <p class="mt-3 text-sm text-muted">Demo news goes out with our studio updates.</p>
          )
        }
      </div>

      <GameArt
        title={game.title}
        gradient={game.gradient}
        image={game.hero}
        alt={`Key art for ${game.title}`}
        loading="eager"
        showPlaceholderNote={game.needsArt}
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <dl class="grid gap-6 rounded-2xl border border-gray-200 p-6 sm:grid-cols-2 lg:grid-cols-4 dark:border-white/10">
      {
        facts.map((fact) => (
          <div>
            <dt class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-muted">
              <Icon name={fact.icon} class="h-4 w-4" />
              {fact.label}
            </dt>
            <dd class="mt-1.5 font-medium">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <h2 class="font-heading text-3xl font-bold tracking-tight">About the game</h2>
        {game.body.map((paragraph) => <p class="mt-4 text-lg text-muted">{paragraph}</p>)}
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {
          game.features.map((feature) => (
            <div class="rounded-xl border border-gray-200 p-5 dark:border-white/10">
              <Icon name={feature.icon} class="h-7 w-7 text-primary dark:text-accent" />
              <h3 class="mt-3 font-bold leading-tight">{feature.title}</h3>
              <p class="mt-1.5 text-sm text-muted">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    game.gallery && game.gallery.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
        <h2 class="mb-8 font-heading text-3xl font-bold tracking-tight">Screenshots</h2>
        <div class:list={['grid gap-6 sm:grid-cols-2', game.galleryRatio ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
          {game.gallery.map((shot) => (
            <figure>
              {'video' in shot ? (
                <video
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  aria-label={shot.caption}
                  class:list={['w-full rounded-xl object-cover shadow-md', game.galleryRatio ?? 'aspect-video']}
                >
                  <source src={`/videos/${shot.video}.mp4`} type="video/mp4" />
                  <source src={`/videos/${shot.video}.webm`} type="video/webm" />
                </video>
              ) : (
                <Image
                  src={shot.image}
                  alt={shot.caption}
                  loading="lazy"
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 100vw, 400px"
                  class:list={['w-full rounded-xl object-cover shadow-md', game.galleryRatio ?? 'aspect-video']}
                />
              )}
              <figcaption class="mt-2 text-sm text-muted">{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {
    game.slug === 'save-file-0' && (
      <section id="save-file-0-updates" class="scroll-mt-24 mx-auto max-w-6xl px-4 pb-16 md:px-6" aria-labelledby="save-file-0-updates-heading">
        <div class="rounded-2xl border border-gray-200 p-6 sm:p-10 dark:border-white/10">
          <div class="mx-auto max-w-2xl">
            <p class="text-sm font-bold uppercase tracking-wide text-primary dark:text-accent">Save File 0 updates</p>
            <h2 id="save-file-0-updates-heading" class="mt-2 font-heading text-3xl font-bold tracking-tight">
              Want to know when you can play it?
            </h2>
            <p class="mt-4 text-muted">
              We're working towards a free playable demo and exploring a proper physical Game Boy Color release.
              Join our studio mailing list and we'll share updates when there's something worth showing.
            </p>
            <form
              action="https://ki10games.us4.list-manage.com/subscribe/post?u=95a2806341f85cb6e7b58cab0&id=67ed6c3e3d&v_id=73&f_id=00b021e1f0"
              method="post"
              target="_blank"
              class="mt-6"
            >
              <label for="save-file-0-email" class="block text-sm font-semibold">Email address</label>
              <div class="mt-2 flex flex-col gap-3 sm:flex-row">
                <input
                  id="save-file-0-email"
                  type="email"
                  name="EMAIL"
                  autocomplete="email"
                  required
                  placeholder="you@example.com"
                  class="min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-gray-600 dark:bg-gray-800 dark:text-white"
                />
                <button type="submit" name="subscribe" class="btn btn-primary shrink-0">
                  Get game updates
                </button>
              </div>
              <label class="mt-4 flex items-start gap-3 text-sm text-muted">
                <input
                  type="checkbox"
                  name="gdpr[43380]"
                  value="Y"
                  required
                  class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 text-primary focus:ring-primary"
                />
                <span>Yes, email me Ki10 Games devlogs and studio news, including Save File 0 updates.</span>
              </label>
              <div aria-hidden="true" class="absolute -left-[5000px]">
                <input
                  type="text"
                  name="b_95a2806341f85cb6e7b58cab0_67ed6c3e3d"
                  tabindex="-1"
                  value=""
                />
              </div>
              <p class="mt-3 text-xs text-muted">
                This is our studio mailing list, not a separate Save File 0-only list.
                You can unsubscribe at any time. See our <a href="/privacy" class="underline hover:text-primary">privacy policy</a>.
              </p>
            </form>
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="font-heading text-3xl font-bold tracking-tight">Devlogs about {game.title}</h2>
          <a
            href={`/tag/${game.devlogTag}`}
            class="text-sm font-semibold text-primary hover:underline dark:text-accent"
          >
            See all &rarr;
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-3">
          {posts.map((post) => (
            <a
              href={getPermalink(post.permalink, 'post')}
              class="group rounded-xl border border-gray-200 p-5 transition hover:border-gray-300 hover:shadow-md dark:border-white/10 dark:hover:border-white/25"
            >
              <h3 class="font-bold leading-tight group-hover:text-primary dark:group-hover:text-accent">
                {post.title}
              </h3>
              <p class="mt-2 line-clamp-3 text-sm text-muted">{post.excerpt}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: game.slug === 'save-file-0' ? 'Get Save File 0 updates' : game.slug === 'boop-n-burn' ? 'Get demo updates' : 'Get studio updates',
        href: game.slug === 'save-file-0' ? '#save-file-0-updates' : '/contact#newsletter',
        icon: 'tabler:mail',
      },
      { text: 'Read the devlog', href: '/devlog', icon: 'tabler:notebook' },
      { text: 'Get in touch', href: '/contact', icon: 'tabler:mail' },
    ]}
  >
    <Fragment slot="title">{cta.title}</Fragment>
    <Fragment slot="subtitle">{cta.subtitle}</Fragment>
  </CallToAction>
</Layout>
