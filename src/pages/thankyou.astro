---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Thank You for Subscribing!',
  description: 'Thanks for joining our mailing list. Please check your inbox to confirm your subscription.',
  robots: {
    index: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="ki10-container py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-[#e6f7f4] text-[#0d8a78] dark:bg-[#0f2e2b] dark:text-[#2dd4bf]">
        <Icon name="tabler:mail-check" class="h-9 w-9" />
      </span>
      <h1 class="mt-5 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl">
        Check your inbox
      </h1>
      <p class="mt-3 text-lg text-muted">Thanks for signing up for the Ki10 devlog.</p>

      <div class="ki10-panel mt-8 p-6 text-left">
        <h2 class="font-heading text-lg font-bold text-heading">One last step: confirm your email</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          To finish subscribing, head to your inbox and click the confirmation link we just sent over.
        </p>
        <p class="mt-2 text-xs text-muted">
          If it doesn’t turn up in a few minutes, have a quick peek in your spam or junk folder.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <a href="/devlog" class="ki10-card ki10-card-interactive p-5 text-left">
          <p class="font-heading font-bold text-heading">Read the latest devlog &rarr;</p>
          <p class="mt-1 text-sm text-muted">Catch up on what we’ve been building.</p>
        </a>
        <a href="/projects" class="ki10-card ki10-card-interactive p-5 text-left">
          <p class="font-heading font-bold text-heading">Play our games &rarr;</p>
          <p class="mt-1 text-sm text-muted">Try Skill Check or The One Bullet Job.</p>
        </a>
      </div>

      <div class="mt-8">
        <a href="/" class="text-sm font-bold text-secondary hover:underline">&larr; Back to homepage</a>
      </div>
    </div>
  </section>
</Layout>
