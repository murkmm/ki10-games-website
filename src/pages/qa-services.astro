---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import markPhoto from '~/assets/images/team-mark.webp';

const metadata = {
  title: 'Indie Game QA Testing from £25 | Ki10 Games',
  description:
    'Professional manual game QA for small indie developers. Affordable fixed-price testing, actionable bug reports and an experienced UK game tester on your side.',
};

const packages = [
  {
    name: 'Quick Check',
    price: '25',
    hours: '1 hour',
    line: 'An extra check on a feature or build.',
    for: 'A new feature, a quick demo check or an early build',
    features: ['Focused exploratory testing', 'Clear defects with reproduction steps', 'Concise findings summary'],
  },
  {
    name: 'Indie Playtest',
    price: '65',
    hours: '3 hours',
    line: 'A proper look at your demo or milestone.',
    for: 'Demos, development milestones and important updates',
    featured: true,
    features: ['Gameplay, controls, UI and progression checks', 'Prioritised defect list and evidence where useful', 'Practical usability observations and handover'],
  },
  {
    name: 'Release Readiness',
    price: '120',
    hours: '6 hours',
    line: 'A bit more time before you release.',
    for: 'Upcoming showcases, demos and releases',
    features: ['Agreed risk-focused testing coverage', 'Bug reports with steps, severity and evidence', 'Written release-readiness summary'],
  },
];

const faqs = [
  ['What can you test?', 'Windows PC and Android are core targets. Steam Deck may also be available. We confirm device, build and access requirements before booking. We do not provide console certification.'],
  ['Do the package hours include reporting?', 'Yes. The advertised time includes hands-on testing and preparing your report, for one agreed build. We agree priority areas before starting.'],
  ['How do booking and payment work?', 'Email us about your game. We confirm compatibility, the scope, a delivery date and a fixed quote. Once you accept, we issue an invoice. Small one-off packages are paid before testing begins. Payments are arranged through the invoice, not through this website.'],
  ['Can you sign an NDA?', 'Yes. We can discuss reasonable confidentiality terms before you share a private build. We do not publish client builds or reports without permission.'],
  ['Do you include retesting?', 'A booking covers one agreed build; retests and further builds are quoted separately.'],
  ['How soon will I get my report?', 'We agree the delivery date before you book, based on build readiness and our availability.'],
  ['What if no bugs are found?', 'You still receive an honest summary of the areas tested and any observations. We never invent defects or guarantee a minimum number of findings.'],
  ['Does your testing guarantee a bug-free launch?', 'No finite QA pass guarantees a bug-free game. We provide evidence and risk information to help your team decide what to fix next.'],
];

function enquiry(name: string) {
  const lines = [
    'Hi Ki10 Games,', '', 'I would like to enquire about manual game QA.',
    '', 'Game name / link:', 'Platform:', 'Build available (Y/N):',
    'Package or budget: ' + name, 'Ideal delivery date:', 'Areas you want checked:',
    '', 'Thanks!',
  ];
  return 'mailto:business@ki10games.com?subject=' +
    encodeURIComponent('QA enquiry — ' + name) +
    '&body=' + encodeURIComponent(lines.join('\n'));
}
---

<Layout metadata={metadata}>
  <main class="qa">
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker"><span class="pulse"></span> KI10 GAMES / QA SERVICES</p>
        <h1>Need another pair of eyes on your game?</h1>
        <p class="hero-sub">I'm Mark. I've spent <strong>10 years testing games professionally</strong>, and now I make my own at Ki10. If you need someone to put your demo or next build through its paces, I can help.</p>
        <div class="buttons">
          <a class="btn primary" href={enquiry('Project enquiry')}>Ask about testing <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
          <a class="btn ghost" href="#packages">See prices <Icon name="tabler:arrow-down" aria-hidden="true" /></a>
        </div>
        <p class="hero-note"><Icon name="tabler:circle-check" aria-hidden="true" /> From £25 · No retainer · No pressure</p>
      </div>
      <aside class="tester-card">
        <div class="tester-head">
          <Image src={markPhoto} alt="Mark McManus, Ki10 Games co-founder" width={94} height={94} class="tester-photo" loading="eager" />
          <div><p class="eyebrow">Your tester</p><h2>Mark McManus</h2><p>Ki10 Games co-founder</p></div>
        </div>
        <p>I've been working in games QA for 10 years. I know the difference between a report that helps you fix something and one that just leaves you with more questions.</p>
        <p class="personal">I make games too, so I know there's never enough time or money to test absolutely everything. I'll help you concentrate on the bits that matter most.</p>
        <a href="https://markmcmanus.net/" target="_blank" rel="noopener noreferrer">Read about my experience <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <section class="credentials">
      <div class="container credentials-grid">
        <div><strong>10 years</strong><span>Professional game QA experience</span></div>
        <div><strong>We make games too</strong><span>We understand small-team budgets</span></div>
        <div><strong>UK-based</strong><span>Remote support for small studios</span></div>
        <a href="https://markmcmanus.net/" target="_blank" rel="noopener noreferrer">Read about Mark’s work <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
      </div>
    </section>

    <section class="section container">
      <div class="heading-grid"><div><p class="eyebrow orange">WHY KI10?</p><h2>Useful feedback.<br /><em>Clear bugs.</em></h2></div><p>We know what it’s like to be a small team getting ready to ship. We’ll spend the agreed time testing the areas you care about, then give you findings you can use.</p></div>
      <div class="benefits">
        <article><span class="benefit-icon"><Icon name="tabler:route" aria-hidden="true" /></span><h3>Find the blockers</h3><p>Progression problems, soft locks, broken objectives and gameplay edge cases.</p></article>
        <article><span class="benefit-icon"><Icon name="tabler:device-gamepad-2" aria-hidden="true" /></span><h3>Understand the friction</h3><p>Controller quirks, usability issues, confusing UI and moments where players get stuck.</p></article>
        <article><span class="benefit-icon"><Icon name="tabler:clipboard-check" aria-hidden="true" /></span><h3>Give you something to work with</h3><p>Reports with reproduction steps, severity and supporting screenshots or clips where useful.</p></article>
      </div>
    </section>

    <section class="milestone"><div class="container">
      <p class="eyebrow">THE RIGHT TIME FOR QA</p>
      <h2>A demo coming up?<br /><em>Let's give it a proper test.</em></h2>
      <p>If you’re working alone, it can be difficult to see problems in a game you know inside out. Tell me what you're getting ready for and we'll work out what needs checking.</p>
      <a href={enquiry('Milestone testing')} class="text-cta">Tell me about your game <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
    </div></section>

    <section id="packages" class="section container pricing">
      <div class="center"><p class="eyebrow orange">FIXED PRICES · FLEXIBLE SCOPE</p><h2>Affordable testing.<br /><em>No fuss.</em></h2><p>You pick a package, we agree the priorities, and I tell you exactly what you'll get.</p></div>
      <div class="plans">
        {packages.map((pkg) => <article class:list={['plan', { featured: pkg.featured }]}>
          {pkg.featured && <div class="featured-tag">GOOD FOR DEMOS</div>}
          <p class="plan-hours">{pkg.hours} total · testing + reporting</p>
          <h3>{pkg.name}</h3><p class="plan-sub">{pkg.line}</p>
          <p class="price"><span>£</span>{pkg.price}</p>
          <p class="for">{pkg.for}</p><div class="plan-divider"></div>
          <p class="list-label">INCLUDED</p>
          <ul>{pkg.features.map((item) => <li><Icon name="tabler:check" aria-hidden="true" /> {item}</li>)}</ul>
          <a class:list={['plan-link', { best: pkg.featured }]} href={enquiry(pkg.name)}>Enquire about {pkg.name} <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
        </article>)}
      </div>
      <p class="pricing-fine">Introductory package prices in GBP, subject to agreed scope and device compatibility. One build per package. Retesting and further builds are separate. Applicable VAT, if any, will be confirmed in the quote; no VAT status is implied here.</p>
      <div class="custom"><Icon name="tabler:messages" aria-hidden="true" /><div><strong>Need ongoing testing instead?</strong><p>Regular builds, bigger milestones or unusual requirements? Ask for a custom quote.</p></div><a href={enquiry('Custom testing')}>Let's talk <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a></div>
    </section>

    <section class="section container sample-section">
      <div class="heading-grid"><div><p class="eyebrow orange">PROOF IN THE PROCESS</p><h2>See what a useful<br /><em>bug report looks like.</em></h2></div><div><p>Your developer shouldn't need to ask “what did you do to cause this?”. We aim to give you enough context to reproduce an issue quickly.</p><p class="sample-disclaimer">Illustrative fictional example below; not a report from an actual client.</p></div></div>
      <div class="sample">
        <div class="sample-top"><div><span>EXAMPLE ISSUE / BUG-001</span><h3>Character cannot move after closing inventory</h3></div><strong><Icon name="tabler:alert-triangle" aria-hidden="true" /> HIGH PRIORITY</strong></div>
        <div class="sample-details"><div><small>PLATFORM</small><strong>Windows / Controller</strong></div><div><small>BUILD</small><strong>Example 0.1.0</strong></div><div><small>REPRO</small><strong>3 of 3 attempts</strong></div><div><small>STATUS</small><strong>New</strong></div></div>
        <div class="sample-grid"><div><h4>STEPS TO REPRODUCE</h4><ol><li>Load the example checkpoint save.</li><li>Open the inventory using a controller.</li><li>Close it with the back button.</li><li>Attempt to move the character.</li></ol></div><div><h4>EXPECTED</h4><p>Player movement resumes normally.</p><h4>ACTUAL</h4><p>Camera moves, but player movement stays locked until reloading.</p><h4>EVIDENCE</h4><p>A real report includes relevant screenshots, clips or save details when useful.</p></div></div>
      </div>
    </section>

    <section class="booking"><div class="container booking-grid">
      <div><p class="eyebrow">SIMPLE FROM THE FIRST EMAIL</p><h2>A straightforward way<br /><em>to get your game tested.</em></h2><p>We don't take payment on this page. We check your game and agree what you'll get first. Then you receive an invoice, so everything is clear before work starts.</p><a class="btn light" href={enquiry('New project')}>Start an enquiry <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a></div>
      <ol><li><span>01</span><div><strong>Tell us about your game</strong><p>Share your platform, build requirements and next milestone.</p></div></li><li><span>02</span><div><strong>Agree your package</strong><p>We confirm compatibility, focus areas, the delivery date and price.</p></div></li><li><span>03</span><div><strong>Approve and pay</strong><p>We send an invoice with payment instructions. Small bookings are paid upfront.</p></div></li><li><span>04</span><div><strong>Get your findings</strong><p>Receive prioritised issues, evidence where relevant and a short summary.</p></div></li></ol>
    </div></section>

    <section class="section container faq">
      <div class="heading-grid"><div><p class="eyebrow orange">QUESTIONS?</p><h2>A few things<br /><em>worth knowing.</em></h2></div><p>No surprises. Here's how booking works and what you can expect. If you need something different, just ask.</p></div>
      <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<Icon name="tabler:plus" aria-hidden="true" /></summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="bottom container"><div class="bottom-panel"><p class="eyebrow">YOUR GAME HAS COME THIS FAR</p><h2>Got a build<br /><em>you'd like checked?</em></h2><p>Send me a little information about your game and I'll let you know how I can help. No pressure.</p><div class="buttons"><a class="btn primary" href={enquiry('Project enquiry')}>Get a testing quote <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a><a class="btn outline" href="/projects">See our games <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a></div><p class="email">Or email <a href="mailto:business@ki10games.com">business@ki10games.com</a></p></div></section>
  </main>
</Layout>
<style>
.qa{--line:#dedbd4;--surface:#f7f5ef;--ink:#242621;--muted:#63675f;--ember:#a53a13;color:var(--ink)}
:global(.dark) .qa{--line:#33372e;--surface:#1b1e19;--ink:#f2f3e9;--muted:#c4c9bc;--ember:#f7a35a}
.container{max-width:1200px;width:calc(100% - 3rem);margin-inline:auto}
.eyebrow{font-size:.73rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ember)}
.hero{display:grid;grid-template-columns:1.3fr .8fr;align-items:center;gap:4rem;padding-block:4.3rem 4.7rem}
.hero h1{font-size:clamp(2.8rem,5vw,4.7rem);line-height:1.08;letter-spacing:-.06em;font-weight:800;max-width:13ch;margin:1rem 0 1.6rem}
.hero-sub{font-size:1.08rem;line-height:1.85;color:var(--muted);max-width:55ch}
.hero-sub strong{color:var(--ink)}
.buttons{display:flex;flex-wrap:wrap;align-items:center;gap:1.3rem;margin:2rem 0 1rem}
.btn{display:inline-flex;gap:1.2rem;align-items:center;justify-content:center;padding:.88rem 1.15rem;font-size:.88rem;font-weight:750;border-radius:.4rem;text-decoration:none!important}
.btn :global(svg),.text-cta :global(svg),.credentials a :global(svg),.custom a :global(svg),.plan-link :global(svg){width:17px;height:17px;flex:none}
.primary{color:white!important;background:#a53a13}.primary:hover{background:#7e2d11}.ghost{color:var(--ink)!important;text-decoration:underline!important;text-underline-offset:4px}.hero-note{font-size:.8rem;color:var(--muted);display:flex;align-items:center;gap:.45rem}.hero-note :global(svg){width:16px;height:16px;color:#55896a}
.tester-card{border:1px solid var(--line);border-radius:.6rem;background:var(--surface);padding:1.8rem}
.tester-head{display:flex;align-items:center;gap:1rem;padding-bottom:1.3rem;border-bottom:1px solid var(--line)}
.tester-head :global(img){width:88px;height:88px;object-fit:cover;border-radius:50%;flex:none}
.tester-head h2{font-size:1.4rem;font-weight:800;margin:.25rem 0}
.tester-head p:last-child{font-size:.83rem;color:var(--muted)}
.tester-card>p{font-size:.96rem;line-height:1.85;margin-top:1.3rem}.tester-card>.personal{color:var(--muted)}
.tester-card>a{display:inline-block;margin-top:1.4rem;font-size:.89rem;font-weight:750;text-decoration:underline;text-underline-offset:4px}
.credentials{background:#242621;color:#f5f3ed}
.credentials-grid{display:grid;grid-template-columns:repeat(3,1fr) 1.2fr;gap:1.6rem;align-items:center;padding-block:1.6rem}
.credentials-grid>div{display:flex;flex-direction:column;gap:.35rem;border-right:1px solid #ffffff40}
.credentials strong{font-size:1.13rem;font-weight:800}.credentials span{font-size:.79rem;color:#d5d8d2}
.credentials a{font-weight:750;font-size:.85rem;color:#f4b386;display:inline-flex;align-items:center;gap:.4rem}
.section{padding-block:4.5rem}.heading-grid{display:grid;grid-template-columns:1fr .85fr;align-items:center;gap:3rem;margin-bottom:2rem}
.section h2,.milestone h2,.booking h2,.bottom h2{font-size:clamp(2.05rem,3.8vw,3.4rem);font-weight:800;line-height:1.15;letter-spacing:-.045em;margin:.75rem 0 1rem}
.qa em{font-style:normal;color:var(--ember)}
.heading-grid>p,.heading-grid>div:last-child:not(:first-child){font-size:1rem;color:var(--muted);line-height:1.8}
.heading-grid>div:last-child p+p{margin-top:.7rem}
.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
.benefits article{border-top:2px solid var(--line);padding-top:1.4rem}
.benefit-icon{color:var(--ember)}.benefit-icon :global(svg){width:24px;height:24px}
.benefits h3{font-size:1.18rem;font-weight:800;margin:.95rem 0 .5rem}.benefits p{font-size:.92rem;line-height:1.75;color:var(--muted)}
.milestone{padding-block:3.6rem;background:var(--surface);border-block:1px solid var(--line)}
.milestone .container{max-width:1200px}.milestone h2{margin:1rem 0}.milestone p:not(.eyebrow){line-height:1.75;color:var(--muted);max-width:700px}
.text-cta{display:inline-flex;gap:.6rem;align-items:center;margin-top:1.2rem;font-weight:750;text-decoration:underline;text-underline-offset:4px}
.center{text-align:center;max-width:730px;margin:0 auto 2.7rem}.center p:last-child{line-height:1.75;color:var(--muted)}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.plan{position:relative;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:.6rem;padding:1.6rem;background:var(--surface)}
.plan.featured{border-color:#a53a1380}
.featured-tag{position:absolute;top:-13px;right:1rem;background:#a53a13;color:white;font-size:.65rem;font-weight:800;letter-spacing:.08em;padding:.4rem .7rem;border-radius:.3rem}
.plan-hours{font-size:.75rem;color:var(--muted)}.plan h3{font-size:1.4rem;font-weight:800;margin:.8rem 0 .3rem}
.plan-sub{font-size:.9rem;color:var(--muted);min-height:2.7rem}.price{font-size:2.9rem;font-weight:850;letter-spacing:-.05em;margin:.9rem 0}
.price span{font-size:2rem}.for{font-size:.87rem;color:var(--muted);line-height:1.6;min-height:3rem}
.plan-divider{border-top:1px solid var(--line);margin:1.1rem 0}.list-label{font-size:.72rem;font-weight:750;color:var(--ember)}
.plan ul{display:grid;gap:.75rem;flex:1;margin:1rem 0 1.8rem}.plan li{display:flex;align-items:flex-start;gap:.5rem;font-size:.89rem;line-height:1.5}
.plan li :global(svg){width:16px;height:16px;flex:none;color:var(--ember)}
.plan-link{display:flex;justify-content:space-between;align-items:center;padding-top:1rem;border-top:1px solid var(--line);font-weight:750;font-size:.85rem}
.plan-link:hover{text-decoration:underline}.pricing-fine{font-size:.78rem;line-height:1.75;color:var(--muted);margin-top:1.4rem}
.custom{border-top:1px solid var(--line);margin-top:2rem;padding-top:1.3rem;display:flex;align-items:center;gap:1rem}
.custom>:global(svg){width:24px;height:24px;color:var(--ember);flex:none}.custom>div{flex:1}
.custom strong{font-weight:750}.custom p{font-size:.89rem;color:var(--muted);margin-top:.2rem}.custom a{font-size:.88rem;white-space:nowrap;font-weight:750;display:flex;gap:.4rem;align-items:center;text-decoration:underline}
.sample-section{border-top:1px solid var(--line)}.sample-disclaimer{font-size:.83rem}
.sample{border:1px solid var(--line);border-radius:.6rem;overflow:hidden;background:var(--surface)}
.sample-top{padding:1.4rem 1.6rem;display:flex;justify-content:space-between;gap:1rem;align-items:center;border-bottom:1px solid var(--line)}
.sample-top span{font-size:.7rem;font-weight:750;color:var(--ember)}.sample-top h3{font-size:1.3rem;font-weight:800;margin-top:.5rem}
.sample-top>strong{display:flex;align-items:center;gap:.4rem;font-size:.8rem;white-space:nowrap}.sample-top :global(svg){width:17px;height:17px}
.sample-details{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;padding:1.2rem 1.6rem;border-bottom:1px solid var(--line)}
.sample-details div{display:grid;gap:.35rem}.sample-details small{font-size:.7rem;color:var(--muted)}.sample-details strong{font-size:.84rem}
.sample-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:1.5rem 1.6rem}
.sample h4{font-size:.8rem;text-transform:uppercase;color:var(--ember);font-weight:800;margin:.5rem 0}.sample ol{list-style:decimal;padding-left:1.2rem}
.sample li,.sample p{font-size:.91rem;line-height:1.8;color:var(--muted)}.sample-grid h4:not(:first-child){margin-top:1rem}
.booking{padding-block:4.3rem;background:#242621;color:#f4f4ed}
.booking-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:4rem}.booking .eyebrow{color:#f1b58f}.booking h2{color:#f4f4ed}
.booking h2 em{color:#f1b58f}.booking-grid>div>p:not(.eyebrow){color:#d6dad0;line-height:1.8;margin-bottom:1.4rem}
.btn.light{background:#f6f3e9;color:#242621}.booking ol{list-style:none}.booking li{display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid #ffffff3b}
.booking li>span{min-width:2rem;font-size:1.1rem;font-weight:800;color:#f1b58f}.booking li p{margin-top:.3rem;font-size:.89rem;line-height:1.75;color:#d1d8cf}
.faq-list{max-width:950px;border-top:1px solid var(--line)}.faq details{border-bottom:1px solid var(--line)}
.faq summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;list-style:none;padding:1.2rem .2rem;cursor:pointer;font-weight:750}.faq summary::-webkit-details-marker{display:none}
.faq summary :global(svg){width:18px;height:18px;color:var(--ember)}.faq details[open] summary :global(svg){transform:rotate(45deg)}
.faq details p{font-size:.91rem;line-height:1.8;color:var(--muted);padding:0 1.2rem 1.3rem .2rem}
.bottom{padding-bottom:4.5rem}.bottom-panel{padding:3.5rem;background:var(--surface);border:1px solid var(--line);border-radius:.7rem}
.bottom h2{margin:.9rem 0 1.2rem}.bottom-panel>p:not(.eyebrow){max-width:650px;color:var(--muted);line-height:1.8}
.bottom .buttons{justify-content:flex-start}.outline{color:var(--ink);text-decoration:underline!important}
.bottom .email{font-size:.83rem}.bottom .email a{text-decoration:underline}
@media(max-width:950px){.hero{grid-template-columns:1fr;gap:2rem}.tester-card{max-width:650px}.credentials-grid{grid-template-columns:1fr 1fr}.credentials-grid>div{border:0}.heading-grid,.booking-grid{grid-template-columns:1fr;gap:1rem}.benefits,.plans{grid-template-columns:1fr}.plan{max-width:750px;width:100%;margin:auto}.plan-sub,.for{min-height:auto}}
@media(max-width:600px){.container{width:calc(100% - 2rem)}.hero{padding-block:2.9rem}.tester-card{padding:1.3rem}.tester-head :global(img){width:70px;height:70px}.credentials-grid{gap:1rem}.credentials-grid a{grid-column:1/-1}.sample-details{grid-template-columns:1fr 1fr}.sample-grid{grid-template-columns:1fr}.sample-top{flex-direction:column;align-items:flex-start}.custom{flex-wrap:wrap}.bottom-panel{padding:2rem}.booking{padding-block:3rem}}
</style>