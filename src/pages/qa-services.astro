---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Indie Game QA Testing from £25 | Ki10 Games',
  description:
    'Professional manual game QA for small indie developers. Affordable fixed-price testing, actionable bug reports and an experienced UK game tester on your side.',
};

const packages = [
  {
    name: 'Quick Check',
    price: '25',
    hours: '1 hour',
    line: 'A fresh pair of experienced eyes.',
    for: 'A new feature, a quick demo check or an early build',
    features: ['Focused exploratory testing', 'Clear defects with reproduction steps', 'Concise findings summary'],
  },
  {
    name: 'Indie Playtest',
    price: '65',
    hours: '3 hours',
    line: 'More confidence in your next build.',
    for: 'Demos, development milestones and important updates',
    featured: true,
    features: ['Gameplay, controls, UI and progression checks', 'Prioritised defect list and evidence where useful', 'Practical usability observations and handover'],
  },
  {
    name: 'Release Readiness',
    price: '120',
    hours: '6 hours',
    line: 'Make your last pass count.',
    for: 'Upcoming showcases, demos and releases',
    features: ['Agreed risk-focused testing coverage', 'Bug reports with steps, severity and evidence', 'Written release-readiness summary'],
  },
];

const faqs = [
  ['What can you test?', 'Windows PC and Android are core targets. Steam Deck may also be available. We confirm device, build and access requirements before booking. We do not provide console certification.'],
  ['Do the package hours include reporting?', 'Yes. The advertised time includes hands-on testing and preparing your report, for one agreed build. We agree priority areas before starting.'],
  ['How do booking and payment work?', 'Email us about your game. We confirm compatibility, the scope, a delivery date and a fixed quote. Once you accept, we issue an invoice. Small one-off packages are paid before testing begins. Payments are arranged through the invoice, not through this website.'],
  ['Can you sign an NDA?', 'Yes. We can discuss reasonable confidentiality terms before you share a private build. We do not publish client builds or reports without permission.'],
  ['Do you include retesting?', 'A booking covers one agreed build; retests and further builds are quoted separately.'],
  ['How soon will I get my report?', 'We agree the delivery date before you book, based on build readiness and our availability.'],
  ['What if no bugs are found?', 'You still receive an honest summary of the areas tested and any observations. We never invent defects or guarantee a minimum number of findings.'],
  ['Does your testing guarantee a bug-free launch?', 'No finite QA pass guarantees a bug-free game. We provide evidence and risk information to help your team decide what to fix next.'],
];

function enquiry(name: string) {
  const lines = [
    'Hi Ki10 Games,', '', 'I would like to enquire about manual game QA.',
    '', 'Game name / link:', 'Platform:', 'Build available (Y/N):',
    'Package or budget: ' + name, 'Ideal delivery date:', 'Areas you want checked:',
    '', 'Thanks!',
  ];
  return 'mailto:business@ki10games.com?subject=' +
    encodeURIComponent('QA enquiry — ' + name) +
    '&body=' + encodeURIComponent(lines.join('\n'));
}
---

<Layout metadata={metadata}>
  <main class="qa">
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker"><span class="pulse"></span> KI10 GAMES / QA SERVICES</p>
        <h1>Catch the bugs.<br /><em>Keep the fun.</em></h1>
        <p class="hero-sub">Your indie game deserves a professional second look. Get <strong>real, hands-on QA</strong> from a tester with nine years of industry experience — at prices built for small studios.</p>
        <div class="buttons">
          <a class="btn primary" href={enquiry('Project enquiry')}>Get a testing quote <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
          <a class="btn ghost" href="#packages">See packages <Icon name="tabler:arrow-down" aria-hidden="true" /></a>
        </div>
        <p class="hero-note"><Icon name="tabler:circle-check" aria-hidden="true" /> From £25 · No retainer · No obligation to enquire</p>
      </div>
      <div class="hero-art" aria-label="Illustrative bug report panel">
        <span class="halo"></span><span class="halo inner"></span>
        <div class="stamp stamp-a"><Icon name="tabler:target-arrow" aria-hidden="true" /> PROGRESSION</div>
        <div class="stamp stamp-b"><Icon name="tabler:device-gamepad-2" aria-hidden="true" /> CONTROLS</div>
        <div class="terminal">
          <div class="terminal-head"><span class="dots"><i></i><i></i><i></i></span><span>KI10 / QA REPORT</span><span class="fake">SAMPLE</span></div>
          <div class="terminal-body">
            <div class="code-line"><span>BUILD REVIEW // 001</span><Icon name="tabler:bug" aria-hidden="true" /></div>
            <h2>A little issue.<br /><em>A clear way to fix it.</em></h2>
            <div class="bug-ticket">
              <div class="ticket-row"><span>BUG-001</span><strong>HIGH PRIORITY</strong></div>
              <p>Movement locks after closing the inventory</p>
              <div class="chips"><span>Input</span><span>3 / 3 repro</span><span>Windows</span></div>
            </div>
            <div class="expected"><div><small>EXPECTED</small><p>Movement resumes</p></div><div><small>ACTUAL</small><p>Player remains stuck</p></div></div>
            <div class="terminal-bottom"><span class="led"></span> STEPS · SEVERITY · EVIDENCE</div>
          </div>
        </div>
        <p class="art-note">Illustrative report example — not real client work</p>
      </div>
    </section>

    <section class="credentials">
      <div class="container credentials-grid">
        <div><strong>9 years</strong><span>Professional game QA experience</span></div>
        <div><strong>Game developers</strong><span>We build and ship our own games</span></div>
        <div><strong>UK-based</strong><span>Remote support for small studios</span></div>
        <a href="https://markmcmanus.net/" target="_blank" rel="noopener noreferrer">See Mark's work history <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
      </div>
    </section>

    <section class="section container">
      <div class="heading-grid"><div><p class="eyebrow orange">WHY KI10?</p><h2>Not just “I played it.”<br /><em>Here's what broke.</em></h2></div><p>We know what it's like to ship a game with a tiny team. Your budget is limited and every fix matters. We turn play sessions into practical findings you can actually investigate.</p></div>
      <div class="benefits">
        <article><span class="benefit-icon"><Icon name="tabler:route" aria-hidden="true" /></span><h3>Find the blockers</h3><p>Progression problems, soft locks, broken objectives and gameplay edge cases.</p></article>
        <article><span class="benefit-icon"><Icon name="tabler:device-gamepad-2" aria-hidden="true" /></span><h3>Understand the friction</h3><p>Controller quirks, usability issues, confusing UI and moments where players get stuck.</p></article>
        <article><span class="benefit-icon"><Icon name="tabler:clipboard-check" aria-hidden="true" /></span><h3>Make the fixes easier</h3><p>Reports with reproduction steps, severity and supporting screenshots or clips where useful.</p></article>
      </div>
    </section>

    <section class="milestone"><div class="container">
      <p class="eyebrow">THE RIGHT TIME FOR QA</p>
      <h2>A demo. An update. A release.<br /><em>Get another set of eyes.</em></h2>
      <p>Whether you're preparing for a showcase, releasing your first public build or trying to tidy up a tricky feature, we'll agree on the most useful test focus before you spend a penny.</p>
      <a href={enquiry('Milestone testing')} class="text-cta">Talk through your next milestone <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
    </div></section>

    <section id="packages" class="section container pricing">
      <div class="center"><p class="eyebrow orange">FIXED PRICES · FLEXIBLE SCOPE</p><h2>Professional QA.<br /><em>Indie-sized budget.</em></h2><p>No long contracts. No mysterious day rates. A defined number of hours and a clear deliverable.</p></div>
      <div class="plans">
        {packages.map((pkg) => <article class:list={['plan', { featured: pkg.featured }]}>
          {pkg.featured && <div class="featured-tag"><Icon name="tabler:star-filled" aria-hidden="true" /> MOST POPULAR STARTING POINT</div>}
          <p class="plan-hours">{pkg.hours} total · testing + reporting</p>
          <h3>{pkg.name}</h3><p class="plan-sub">{pkg.line}</p>
          <p class="price"><span>£</span>{pkg.price}</p>
          <p class="for">{pkg.for}</p><div class="plan-divider"></div>
          <p class="list-label">INCLUDED</p>
          <ul>{pkg.features.map((item) => <li><Icon name="tabler:check" aria-hidden="true" /> {item}</li>)}</ul>
          <a class:list={['plan-link', { best: pkg.featured }]} href={enquiry(pkg.name)}>Enquire about {pkg.name} <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
        </article>)}
      </div>
      <p class="pricing-fine">Introductory package prices in GBP, subject to agreed scope and device compatibility. One build per package. Retesting and further builds are separate. Applicable VAT, if any, will be confirmed in the quote; no VAT status is implied here.</p>
      <div class="custom"><Icon name="tabler:messages" aria-hidden="true" /><div><strong>Need ongoing testing instead?</strong><p>Regular builds, bigger milestones or unusual requirements? Ask for a custom quote.</p></div><a href={enquiry('Custom testing')}>Let's talk <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a></div>
    </section>

    <section class="section container sample-section">
      <div class="heading-grid"><div><p class="eyebrow orange">PROOF IN THE PROCESS</p><h2>See what a useful<br /><em>bug report looks like.</em></h2></div><div><p>Your developer shouldn't need to ask “what did you do to cause this?”. We aim to give you enough context to reproduce an issue quickly.</p><p class="sample-disclaimer">Illustrative fictional example below; not a report from an actual client.</p></div></div>
      <div class="sample">
        <div class="sample-top"><div><span>EXAMPLE ISSUE / BUG-001</span><h3>Character cannot move after closing inventory</h3></div><strong><Icon name="tabler:alert-triangle" aria-hidden="true" /> HIGH PRIORITY</strong></div>
        <div class="sample-details"><div><small>PLATFORM</small><strong>Windows / Controller</strong></div><div><small>BUILD</small><strong>Example 0.1.0</strong></div><div><small>REPRO</small><strong>3 of 3 attempts</strong></div><div><small>STATUS</small><strong>New</strong></div></div>
        <div class="sample-grid"><div><h4>STEPS TO REPRODUCE</h4><ol><li>Load the example checkpoint save.</li><li>Open the inventory using a controller.</li><li>Close it with the back button.</li><li>Attempt to move the character.</li></ol></div><div><h4>EXPECTED</h4><p>Player movement resumes normally.</p><h4>ACTUAL</h4><p>Camera moves, but player movement stays locked until reloading.</p><h4>EVIDENCE</h4><p>A real report includes relevant screenshots, clips or save details when useful.</p></div></div>
      </div>
    </section>

    <section class="booking"><div class="container booking-grid">
      <div><p class="eyebrow">SIMPLE FROM THE FIRST EMAIL</p><h2>No awkward process.<br /><em>Just useful testing.</em></h2><p>We don't take payment on this page. We check your game and agree what you'll get first. Then you receive an invoice, so everything is clear before work starts.</p><a class="btn light" href={enquiry('New project')}>Start an enquiry <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a></div>
      <ol><li><span>01</span><div><strong>Tell us about your game</strong><p>Share your platform, build requirements and next milestone.</p></div></li><li><span>02</span><div><strong>Agree your package</strong><p>We confirm compatibility, focus areas, the delivery date and price.</p></div></li><li><span>03</span><div><strong>Approve and pay</strong><p>We send an invoice with payment instructions. Small bookings are paid upfront.</p></div></li><li><span>04</span><div><strong>Get your findings</strong><p>Receive prioritised issues, evidence where relevant and a short summary.</p></div></li></ol>
    </div></section>

    <section class="section container faq">
      <div class="heading-grid"><div><p class="eyebrow orange">QUESTIONS?</p><h2>The practical stuff,<br /><em>sorted.</em></h2></div><p>No surprises. Here's how booking works and what you can expect. If you need something different, just ask.</p></div>
      <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<Icon name="tabler:plus" aria-hidden="true" /></summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="bottom container"><div class="bottom-panel"><p class="eyebrow">YOUR GAME HAS COME THIS FAR</p><h2>Let's catch the issues<br /><em>before your players do.</em></h2><p>Tell us a little about your game. We'll help you pick a sensible test scope, without a hard sell.</p><div class="buttons"><a class="btn primary" href={enquiry('Project enquiry')}>Get a testing quote <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a><a class="btn outline" href="/projects">See our games <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a></div><p class="email">Or email <a href="mailto:business@ki10games.com">business@ki10games.com</a></p></div></section>
  </main>
</Layout>
<style>
.qa{--hot:#ad451d;--ink:#202723;--dark:#18231f;--border:#858d853b;overflow:hidden}
.container{max-width:1200px;width:calc(100% - 3rem);margin-inline:auto}.qa em{font-style:normal;color:#af491f}.eyebrow{font-size:.7rem;font-weight:850;letter-spacing:.13em;line-height:1.4}.orange{color:#b0491c}
.hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:3rem;min-height:640px;padding-block:4rem}.hero-kicker{color:var(--aw-color-text-muted);display:flex;align-items:center;gap:.65rem}.pulse{height:9px;width:9px;border-radius:50%;background:#b95c30;box-shadow:0 0 0 5px #b95c3024}.hero h1{font-size:clamp(3.3rem,6vw,6.1rem);line-height:1;letter-spacing:-.07em;font-weight:900;max-width:12ch;margin:1.3rem 0 1.8rem}.hero-sub{font-size:clamp(1.08rem,1.8vw,1.22rem);color:var(--aw-color-text-muted);line-height:1.7;max-width:48ch}.hero-sub strong{color:var(--aw-color-text)}
.buttons{display:flex;gap:.75rem;flex-wrap:wrap;margin:2rem 0 1.1rem}.btn{display:inline-flex;gap:.6rem;align-items:center;justify-content:center;padding:.9rem 1.15rem;border-radius:8px;text-decoration:none!important;font-size:.88rem;font-weight:800;transition:transform .2s}.btn:hover,.plan-link:hover{transform:translateY(-2px)}.btn :global(svg),.text-cta :global(svg),.credentials a :global(svg),.custom a :global(svg),.plan-link :global(svg){width:17px;height:17px;flex:none}.primary{background:#ac421a;color:#fff!important;box-shadow:0 8px 25px #ad451d2b}.primary:hover{background:#8a3514}.ghost{color:var(--aw-color-text)!important;border:1px solid var(--border)}.hero-note{display:flex;gap:.5rem;align-items:center;color:var(--aw-color-text-muted);font-size:.8rem}.hero-note :global(svg){width:17px;height:17px;color:#4a966d}
.hero-art{position:relative;min-height:500px;display:grid;place-items:center}.halo{position:absolute;inset:4% 1%;border:1px solid #b8805f4d;border-radius:50%;transform:rotate(24deg)}.halo.inner{inset:12% -2%;transform:rotate(-20deg)}.stamp{position:absolute;z-index:3;background:#24342c;color:#ffe2bf;border:1px solid #8b9a8d77;box-shadow:0 8px 28px #0004;padding:.65rem .8rem;border-radius:6px;letter-spacing:.1em;font:800 .66rem ui-monospace,monospace;display:flex;align-items:center;gap:.4rem}.stamp :global(svg){width:16px;height:16px;color:#f0a26c}.stamp-a{right:0;top:7%;transform:rotate(7deg)}.stamp-b{left:1%;bottom:19%;transform:rotate(-5deg)}.terminal{position:relative;z-index:1;width:96%;max-width:545px;background:#18241e;color:#edf4ed;border-radius:16px;overflow:hidden;transform:rotate(-2deg);box-shadow:0 35px 85px #0c231e46;border:1px solid #6b7d6e}.terminal-head{display:flex;align-items:center;gap:.9rem;padding:.8rem 1.1rem;background:#2a3a31;border-bottom:1px solid #617064;font:700 .61rem ui-monospace,monospace;letter-spacing:.12em;color:#c1cfbf}.dots{display:flex;gap:5px}.dots i{width:7px;height:7px;border-radius:50%;background:#bd7655}.dots i:nth-child(2){background:#d3ae69}.dots i:nth-child(3){background:#8bc19c}.fake{margin-left:auto;color:#ffb27d;background:#3b503f;padding:.2rem .4rem;border-radius:3px}.terminal-body{padding:2rem}.code-line{display:flex;align-items:center;justify-content:space-between;color:#f1ad7d;font:700 .67rem ui-monospace,monospace;letter-spacing:.1em}.code-line :global(svg){width:22px;height:22px}.terminal h2{font-size:clamp(1.5rem,2.7vw,2.25rem);font-weight:850;line-height:1.15;letter-spacing:-.045em;margin:1.2rem 0 1.5rem}.terminal h2 em{color:#b2c5b7}.bug-ticket{padding:1rem;border-radius:9px;background:#2a3d31;border:1px solid #637764}.ticket-row{display:flex;justify-content:space-between;gap:.3rem;font:800 .65rem ui-monospace,monospace;color:#c4d4c6}.ticket-row strong{color:#ffe3ca;background:#874225;padding:.33rem .5rem;border-radius:3px;font-size:.6rem}.bug-ticket p{font-size:1.05rem;line-height:1.35;font-weight:750;margin:1rem 0}.chips{display:flex;gap:.45rem;flex-wrap:wrap}.chips span{font:700 .66rem ui-monospace,monospace;color:#d9e6d9;background:#3c5241;padding:.3rem .5rem;border-radius:4px}.expected{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:.75rem}.expected div{background:#2a3d31;border-radius:6px;padding:.8rem}.expected small{font:800 .6rem ui-monospace,monospace;color:#f0ab79}.expected p{font-size:.8rem;margin:.3rem 0 0}.terminal-bottom{display:flex;align-items:center;gap:.45rem;margin-top:1.2rem;padding-top:1rem;border-top:1px solid #667969;font:700 .63rem ui-monospace,monospace;color:#afc6b2}.led{height:7px;width:7px;border-radius:50%;background:#73d49d}.art-note{position:absolute;right:1rem;bottom:0;color:var(--aw-color-text-muted);font-size:.72rem}
.credentials{background:#1b2520;color:#f5f4ef}.credentials-grid{display:grid;grid-template-columns:repeat(3,1fr) 1.2fr;gap:1.6rem;align-items:center;padding-block:1.6rem}.credentials-grid>div{display:flex;flex-direction:column;gap:.25rem;border-right:1px solid #71807566}.credentials strong{font-size:1.2rem;font-weight:850;letter-spacing:-.03em}.credentials span{font-size:.74rem;color:#b5c2b4}.credentials a{display:inline-flex;align-items:center;gap:.3rem;color:#ffac77;font-weight:800;font-size:.82rem}
.section{padding-block:5.4rem}.heading-grid{display:grid;grid-template-columns:1fr .85fr;align-items:center;gap:3rem;margin-bottom:2rem}.section h2,.milestone h2,.booking h2,.bottom h2{font-size:clamp(2.2rem,4.6vw,4.6rem);font-weight:900;line-height:1.07;letter-spacing:-.06em;margin-top:.85rem}.heading-grid>p,.heading-grid>div:last-child:not(:first-child){color:var(--aw-color-text-muted);line-height:1.8;font-size:1.03rem}.heading-grid>div:last-child p+p{margin-top:.7rem}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.benefits article{border-radius:13px;border:1px solid var(--border);padding:1.8rem;background:#99999908}.benefit-icon{display:grid;place-items:center;width:47px;height:47px;border-radius:10px;background:#b9532118;color:#b34b1e}.benefit-icon :global(svg){width:24px;height:24px}.benefits h3{font-size:1.25rem;font-weight:850;letter-spacing:-.025em;margin:1.2rem 0 .6rem}.benefits p{font-size:.91rem;line-height:1.75;color:var(--aw-color-text-muted)}
.milestone{background:#e9e4d8;color:#24302a;padding-block:4.6rem;position:relative}.milestone:before{content:'';position:absolute;inset:0;opacity:.15;background-image:linear-gradient(#83928270 1px,transparent 1px),linear-gradient(90deg,#83928270 1px,transparent 1px);background-size:48px 48px;pointer-events:none}.milestone>.container{position:relative}.milestone h2{color:#25332c;margin:.9rem 0 1.4rem}.milestone .eyebrow{color:#9b3d16}.milestone p:not(.eyebrow){line-height:1.75;max-width:670px;color:#546054}.text-cta{display:inline-flex;gap:.5rem;align-items:center;margin-top:1.5rem;color:#a63f18;font-weight:850;text-decoration:underline;text-underline-offset:5px}
