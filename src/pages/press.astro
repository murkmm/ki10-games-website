---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import StatusBadge from '~/components/games/StatusBadge.astro';
import CopyButton from '~/components/common/CopyButton.astro';
import { games } from '~/data/games';
import { studio } from '~/data/studio';

const metadata = {
  title: 'Press Kit',
  description:
    'Press kit for Ki10 Games. Studio fact sheet, logos, screenshots and game information for Save File 0, Skill Check, Boop n Burn, The One Bullet Job and KIT.',
};

const releasedCount = games.filter((g) => g.status === 'released').length;

const studioFacts = [
  { label: 'Studio', value: `${studio.name} (pronounced “Kitten Games”)` },
  { label: 'Founded', value: studio.founded },
  { label: 'Based in', value: studio.location },
  { label: 'Team size', value: '2 (Mark McManus & Scott Hamilton)' },
  { label: 'Games released', value: String(releasedCount) },
  { label: 'Website', value: studio.website },
];

const studioBio =
  'Ki10 Games (pronounced “Kitten Games”) is a two-person independent game studio in the UK, founded by Mark McManus (design, programming and QA) and Scott Hamilton (art and world building). Part of the reason the studio is called Ki10 is their original goal of selling ten copies. They don’t stick to one genre: their released games are Skill Check (daily gaming trivia) and The One Bullet Job (turn-based heist puzzle), and they are currently building Save File 0 (first-person survival horror for Game Boy Color), Boop n Burn (floor-is-lava party brawler), and KIT: Knight in Training.';

const factSheetCopyText = [
  ...studioFacts.map((f) => `${f.label}: ${f.value}`),
  '',
  studioBio,
  '',
  `Press & general contact: ${studio.contactEmail}`,
  `Business enquiries: ${studio.businessEmail}`,
].join('\n');

/** Press assets live in /public/press so their URLs stay stable for press and creators. */
const pressAssets: Record<string, { label: string; href: string; isVideo?: boolean }[]> = {
  'save-file-0': [
    { label: 'Logo (transparent)', href: '/press/save-file-0/save-file-0-logo-transparent.png' },
    { label: 'Key art, 1920×1080', href: '/press/save-file-0/save-file-0-key-art-1920x1080.png' },
    {
      label: 'Handheld & box mock-up',
      href: '/press/save-file-0/save-file-0-handheld-and-box-mockup-1920x1080.png',
    },
    {
      label: 'Physical release mock-up',
      href: '/press/save-file-0/save-file-0-physical-release-mockup-1360x760.png',
    },
    { label: 'Teaser trailer (1080p MP4)', href: '/press/save-file-0/save-file-0-teaser-1080p.mp4', isVideo: true },
    { label: 'The Occupant in a doorway', href: '/press/save-file-0/save-file-0-01-occupant-in-the-doorway.png' },
    { label: 'Save index with FILE 0', href: '/press/save-file-0/save-file-0-03-save-index-file0.png' },
    { label: 'Mara’s revolver note', href: '/press/save-file-0/save-file-0-07-revolver-note.png' },
    { label: 'A crawler', href: '/press/save-file-0/save-file-0-09-crawler.png' },
    { label: 'Photo from the copier', href: '/press/save-file-0/save-file-0-11-photo-from-the-copier.png' },
    { label: 'Inside a locker', href: '/press/save-file-0/save-file-0-12-locker-vents.png' },
    { label: 'Same spot in FILE 0', href: '/press/save-file-0/save-file-0-13-file0-racks-and-locker.png' },
    { label: 'Same spot in your save', href: '/press/save-file-0/save-file-0-14-same-spot-in-player.png' },
  ],
  'boop-n-burn': [
    { label: 'Shipping yard arena', href: '/press/boop-n-burn/bnb-shipyard.webp' },
    { label: 'Ruined temple', href: '/press/boop-n-burn/bnb-ruins.webp' },
    { label: 'Arcade', href: '/press/boop-n-burn/bnb-arcade.webp' },
    { label: 'Warehouse', href: '/press/boop-n-burn/bnb-warehouse.webp' },
    { label: 'Desert coliseum', href: '/press/boop-n-burn/bnb-coliseum.webp' },
  ],
  'the-one-bullet-job': [
    { label: 'Logo', href: '/press/the-one-bullet-job/obj-logo.png' },
    { label: 'Logo on navy', href: '/press/the-one-bullet-job/obj-logo-on-navy.png' },
    { label: 'Key art', href: '/press/the-one-bullet-job/obj-keyart.webp' },
    { label: 'Poster with title', href: '/press/the-one-bullet-job/obj-poster-titled.webp' },
    { label: 'Feature graphic', href: '/press/the-one-bullet-job/obj-feature-graphic.png' },
    { label: 'Home screen', href: '/press/the-one-bullet-job/obj-home.webp' },
    { label: 'Planning a move', href: '/press/the-one-bullet-job/obj-play-vault.webp' },
    { label: 'Taking the shot', href: '/press/the-one-bullet-job/obj-play-shot.webp' },
    { label: 'Laser gates', href: '/press/the-one-bullet-job/obj-play-lasers.webp' },
    { label: 'Reading the patrols', href: '/press/the-one-bullet-job/obj-play-watch.webp' },
    { label: 'Escaped result', href: '/press/the-one-bullet-job/obj-result.webp' },
    { label: 'Masks and outfits', href: '/press/the-one-bullet-job/obj-crew.webp' },
  ],
  'skill-check': [
    { label: 'Main menu', href: '/press/skill-check/skillcheck-menu.webp' },
    { label: 'Matching set', href: '/press/skill-check/skillcheck-card-select.webp' },
    { label: 'Question in play', href: '/press/skill-check/skillcheck-question.webp' },
    { label: 'Collection', href: '/press/skill-check/skillcheck-collection.webp' },
  ],
  'kit-knight-in-training': [
    { label: 'Briarwatch vista (Godot)', href: '/press/kit/kit-godot-vista.webp' },
    { label: 'Briarwatch Green (Godot)', href: '/press/kit/kit-godot-village.webp' },
    { label: 'Long grass leap (Godot)', href: '/press/kit/kit-godot-leap.webp' },
    { label: 'Grass & terrain pass', href: '/press/kit/kit-grass.jpg' },
  ],
};

const logos = [
  { label: 'Primary logo (dark on light)', href: '/press/logos/Ki10_LOGO.png', darkBg: false },
  { label: 'Reversed logo (light on dark)', href: '/press/logos/Ki10_LOGO_Light.png', darkBg: true },
  { label: 'Share card (1200×630)', href: '/press/logos/ki10-share-card.png', darkBg: false },
  { label: 'Team photo (Mark & Scott)', href: '/press/logos/ki10-team.webp', darkBg: false },
];
---

<Layout metadata={metadata}>
  <div class="ki10-container py-10 md:py-14">
    <header class="max-w-3xl">
      <span class="ki10-kicker">
        <Icon name="tabler:news" class="h-4 w-4" />
        Press kit
      </span>
      <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl">
        Logos, screenshots &amp; fact sheets
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        Everything you need to cover Ki10 Games in articles, videos or streams — free to use without asking first. If
        you need a custom capture or size, drop us an email.
      </p>
      <p class="mt-3 text-sm text-muted">
        Want to see who’s written about our games?{' '}
        <a href="/press-coverage" class="font-bold text-secondary hover:underline">Read our press coverage &rarr;</a>
      </p>
    </header>

    <!-- Studio Fact Sheet -->
    <section class="ki10-card mt-8 p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading">Studio fact sheet</h2>
        <div class="flex flex-wrap gap-2">
          <CopyButton text={studioBio} label="Copy bio" copiedLabel="Bio copied!" />
          <CopyButton text={factSheetCopyText} label="Copy full fact sheet" copiedLabel="Fact sheet copied!" />
        </div>
      </div>

      <dl class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          studioFacts.map((fact) => (
            <div>
              <dt class="text-xs font-bold uppercase tracking-wider text-muted">{fact.label}</dt>
              <dd class="mt-1 font-heading font-bold text-heading">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 leading-relaxed text-muted">{studioBio}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3 border-t border-ink pt-6">
        <a href={`mailto:${studio.contactEmail}`} class="btn-primary text-sm">
          <Icon name="tabler:mail" class="h-4 w-4" />
          {studio.contactEmail}
        </a>
        <CopyButton text={studio.contactEmail} label="Copy press email" />
        <a href={`mailto:${studio.businessEmail}`} class="btn-secondary text-sm">
          <Icon name="tabler:briefcase" class="h-4 w-4" />
          {studio.businessEmail}
        </a>
        <CopyButton text={studio.businessEmail} label="Copy business email" />
      </div>
    </section>

    <!-- Logos & Studio Photos -->
    <section class="mt-12">
      <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading">Logos &amp; studio photos</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          logos.map((logo) => (
            <div class="ki10-card flex flex-col overflow-hidden">
              <div
                class:list={[
                  'flex aspect-[16/10] items-center justify-center p-4',
                  logo.darkBg ? 'bg-[#13141a]' : 'bg-subtle',
                ]}
              >
                <img
                  src={logo.href}
                  alt={logo.label}
                  loading="lazy"
                  class="max-h-full max-w-full rounded object-contain"
                />
              </div>
              <div class="flex flex-1 flex-col justify-between gap-3 p-4">
                <span class="text-sm font-bold text-heading">{logo.label}</span>
                <a
                  href={logo.href}
                  download
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-secondary hover:underline"
                >
                  <Icon name="tabler:download" class="h-4 w-4" />
                  Download file
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Game Press Sheets with Thumbnail Grids -->
    <div class="mt-12 space-y-8">
      {
        games.map((game) => (
          <section id={game.slug} class="ki10-card p-6 sm:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap items-center gap-2.5">
                <StatusBadge status={game.status} />
                <span class="text-xs font-bold uppercase tracking-wider text-muted">{game.genre}</span>
              </div>
              <CopyButton text={`${game.title} — ${game.tagline}\n\n${game.pitch}`} label="Copy game pitch" />
            </div>

            <h2 class="mt-3 font-heading text-2xl font-extrabold tracking-tight text-heading sm:text-3xl">
              {game.title}
            </h2>
            <p class="mt-1 font-heading text-base font-bold text-secondary">{game.tagline}</p>
            <p class="mt-3 max-w-3xl leading-relaxed text-muted">{game.pitch}</p>

            <dl class="mt-6 grid gap-4 rounded-xl bg-subtle/70 p-4 sm:grid-cols-2 lg:grid-cols-4">
              <div>
                <dt class="text-xs font-bold uppercase tracking-wider text-muted">Status</dt>
                <dd class="mt-1 text-sm font-bold text-heading">{game.releaseLine}</dd>
              </div>
              <div>
                <dt class="text-xs font-bold uppercase tracking-wider text-muted">Platforms</dt>
                <dd class="mt-1 text-sm font-bold text-heading">{game.platforms.join(' · ')}</dd>
              </div>
              <div>
                <dt class="text-xs font-bold uppercase tracking-wider text-muted">Engine</dt>
                <dd class="mt-1 text-sm font-bold text-heading">{game.engine}</dd>
              </div>
              <div>
                <dt class="text-xs font-bold uppercase tracking-wider text-muted">Game page</dt>
                <dd class="mt-1 text-sm font-bold">
                  <a href={`/projects/${game.slug}`} class="text-secondary hover:underline">
                    /projects/{game.slug}
                  </a>
                </dd>
              </div>
            </dl>

            {pressAssets[game.slug] && (
              <div class="mt-7">
                <h3 class="text-xs font-bold uppercase tracking-wider text-muted">
                  Downloadable art, screenshots &amp; video ({pressAssets[game.slug].length})
                </h3>
                <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                  {pressAssets[game.slug].map((asset) => (
                    <a
                      href={asset.href}
                      download
                      class="group flex flex-col overflow-hidden rounded-xl border border-ink bg-subtle/50 transition hover:border-primary"
                    >
                      <div class="flex aspect-video items-center justify-center overflow-hidden bg-black/85">
                        {asset.isVideo ? (
                          <div class="flex flex-col items-center gap-1.5 text-white/90">
                            <Icon name="tabler:movie" class="h-8 w-8 text-accent" />
                            <span class="text-[0.65rem] font-bold uppercase tracking-wider">1080p MP4</span>
                          </div>
                        ) : (
                          <img
                            src={asset.href}
                            alt={`${game.title} — ${asset.label}`}
                            loading="lazy"
                            class:list={[
                              'h-full w-full object-cover transition duration-300 group-hover:scale-105',
                              { 'pixel-art': game.slug === 'save-file-0' },
                            ]}
                          />
                        )}
                      </div>
                      <span class="flex items-center justify-between gap-2 px-3 py-2 text-xs font-semibold text-heading group-hover:text-secondary">
                        <span class="truncate">{asset.label}</span>
                        <Icon name="tabler:download" class="h-3.5 w-3.5 flex-shrink-0" />
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </section>
        ))
      }
    </div>

    <section class="mt-12">
      <div class="ki10-panel p-6 sm:p-8">
        <h2 class="font-heading text-xl font-extrabold tracking-tight text-heading">Monetisation &amp; usage</h2>
        <p class="mt-2 leading-relaxed text-muted">
          You’re welcome to use the logos, screenshots and text on this page in articles, videos, streams and any other
          coverage of Ki10 Games without asking us first. Please just don’t alter the logos or present our games as
          your own work. Monetised video coverage is completely fine and very much encouraged.
        </p>
      </div>
    </section>
  </div>
</Layout>
