---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { authors } from '~/data/authors';
import { fetchPosts } from '~/utils/blog';

export async function getStaticPaths() {
  const posts = await fetchPosts();
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: {
      author,
      posts: posts.filter((post) => post.author?.trim().toLowerCase() === author.name.toLowerCase()),
    },
  }));
}

const { author, posts } = Astro.props;

const metadata = {
  title: `Posts by ${author.name}`,
  description: `Devlogs written by ${author.name}, ${author.role} at Ki10 Games.`,
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-4 pb-8 pt-12 md:px-6 md:pt-16">
    <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:text-left">
      <Image
        src={author.photo}
        alt={author.name}
        width={96}
        height={96}
        loading="eager"
        class="h-24 w-24 flex-shrink-0 rounded-full object-cover ring-2 ring-primary/40 dark:ring-accent/40"
      />
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-secondary">{author.role}</p>
        <h1 class="mt-1 font-heading text-3xl font-bold tracking-tight md:text-4xl">{author.name}</h1>
        <p class="mt-3 text-muted">{author.bio}</p>
      </div>
    </div>

    <ul class="mt-6 flex flex-wrap justify-center gap-2 sm:justify-start">
      {
        author.focus.map((item) => (
          <li class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-default dark:bg-white/10">{item}</li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-12 md:px-6">
    <h2 class="mb-2 border-t border-gray-200 pt-10 font-heading text-2xl font-bold tracking-tight dark:border-white/10">
      {posts.length}
      {posts.length === 1 ? 'devlog' : 'devlogs'} by {author.name}
    </h2>
    {
      posts.length > 0 ? (
        <BlogList posts={posts} />
      ) : (
        <p class="mt-4 text-muted">Nothing published yet, check back soon!</p>
      )
    }
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'All devlogs', href: '/devlog', icon: 'tabler:notebook' },
      { text: 'Meet the team', href: '/team', icon: 'tabler:users' },
    ]}
  >
    <Fragment slot="title">More from the studio</Fragment>
    <Fragment slot="subtitle">Every devlog we've written, from both of us, all in one place.</Fragment>
  </CallToAction>
</Layout>
