---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import DevlogFilterBar from '~/components/blog/DevlogFilterBar.astro';
import { authors } from '~/data/authors';
import { fetchPosts } from '~/utils/blog';

export async function getStaticPaths() {
  const posts = await fetchPosts();
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: {
      author,
      posts: posts.filter((post) => post.author?.trim().toLowerCase() === author.name.toLowerCase()),
    },
  }));
}

const { author, posts } = Astro.props;

const metadata = {
  title: `Posts by ${author.name}`,
  description: `Devlogs written by ${author.name}, ${author.role} at Ki10 Games.`,
};
---

<Layout metadata={metadata}>
  <div class="ki10-container py-10 md:py-14">
    <section class="ki10-card mb-10 p-6 sm:p-8">
      <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:text-left">
        <Image
          src={author.photo}
          alt={author.name}
          width={96}
          height={96}
          loading="eager"
          class="h-24 w-24 flex-shrink-0 rounded-2xl border-2 border-primary/40 object-cover"
        />
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-secondary">{author.role}</p>
          <h1 class="mt-1 font-heading text-3xl font-extrabold tracking-tight text-heading md:text-4xl">
            {author.name}
          </h1>
          <p class="mt-3 max-w-2xl text-muted">{author.bio}</p>
        </div>
      </div>

      <ul class="mt-5 flex flex-wrap justify-center gap-2 sm:justify-start">
        {
          author.focus.map((item) => (
            <li class="rounded-lg bg-subtle px-2.5 py-1 text-xs font-semibold text-default">{item}</li>
          ))
        }
      </ul>
    </section>

    <DevlogFilterBar activeSlug={`author:${author.slug}`} />

    <section>
      <h2 class="mb-6 font-heading text-2xl font-extrabold tracking-tight text-heading">
        {posts.length} {posts.length === 1 ? 'devlog' : 'devlogs'} by {author.name}
      </h2>
      {
        posts.length > 0 ? (
          <BlogList posts={posts} />
        ) : (
          <p class="mt-4 text-muted">Nothing published yet — check back soon!</p>
        )
      }
    </section>
  </div>
</Layout>
