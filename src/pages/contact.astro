---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import NewsletterForm from '~/components/common/NewsletterForm.astro';
import CopyButton from '~/components/common/CopyButton.astro';
import { studio } from '~/data/studio';

const metadata = {
  title: 'Contact',
  description:
    'Get in touch with Ki10 Games for press, business, QA services or general enquiries, join the mailing list, or follow us on social media.',
};
---

<Layout metadata={metadata}>
  <div class="ki10-container py-10 md:py-14">
    <header class="max-w-3xl">
      <span class="ki10-kicker">
        <Icon name="tabler:mail" class="h-4 w-4" />
        Contact
      </span>
      <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl">
        Get in touch &amp; follow along
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        Whether it’s press, a bug report, QA testing, a partnership idea, or you just want to say hi — here’s where to
        find us.
      </p>
    </header>

    <!-- Email + Discord -->
    <section class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <div class="ki10-card flex flex-col justify-between p-6">
        <div>
          <span
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/15 text-primary dark:text-accent"
          >
            <Icon name="tabler:mail" class="h-5 w-5" />
          </span>
          <h2 class="mt-4 font-heading text-xl font-bold text-heading">Questions &amp; press</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            Feedback, media kits, bug reports, or just saying hello.
          </p>
          <p class="mt-4 font-heading text-base font-bold text-secondary">{studio.contactEmail}</p>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={`mailto:${studio.contactEmail}`} class="btn-primary px-4 py-2 text-xs">Send email</a>
          <CopyButton text={studio.contactEmail} label="Copy address" />
        </div>
      </div>

      <div class="ki10-card flex flex-col justify-between p-6">
        <div>
          <span
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/15 text-primary dark:text-accent"
          >
            <Icon name="tabler:briefcase" class="h-5 w-5" />
          </span>
          <h2 class="mt-4 font-heading text-xl font-bold text-heading">Work with us</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            Publishing, partnerships, QA testing enquiries or other business questions.
          </p>
          <p class="mt-4 font-heading text-base font-bold text-secondary">{studio.businessEmail}</p>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={`mailto:${studio.businessEmail}`} class="btn-primary px-4 py-2 text-xs">Send email</a>
          <CopyButton text={studio.businessEmail} label="Copy address" />
        </div>
      </div>

      <div class="ki10-panel flex flex-col justify-between p-6 md:col-span-2 lg:col-span-1">
        <div>
          <span
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/15 text-primary dark:text-accent"
          >
            <Icon name="tabler:brand-discord" class="h-5 w-5" />
          </span>
          <h2 class="mt-4 font-heading text-xl font-bold text-heading">Join our Discord</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            Come talk to us about our games, or tell us what you’ve been playing and working on — we’d love to have you.
          </p>
        </div>
        <div class="mt-5">
          <a href={studio.discordUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full text-sm">
            <Icon name="tabler:brand-discord" class="h-4 w-4" />
            Join Discord server
          </a>
        </div>
      </div>
    </section>

    <!-- QA Services callout -->
    <section class="mt-10">
      <div class="ki10-panel flex flex-col items-start justify-between gap-5 p-6 sm:flex-row sm:items-center sm:p-7">
        <div>
          <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading">
            Need an experienced game tester?
          </h2>
          <p class="mt-1.5 text-muted">
            We offer affordable, fixed-price manual QA passes for indie developers and small studios.
          </p>
        </div>
        <a href="/qa-services" class="btn-secondary flex-shrink-0 text-sm">
          Explore QA Services &rarr;
        </a>
      </div>
    </section>

    <!-- Mailing List (preserves #newsletter anchor!) -->
    <section id="newsletter" class="mt-12 scroll-mt-24">
      <div class="ki10-card mx-auto max-w-2xl p-6 sm:p-8">
        <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading sm:text-3xl">
          Get the devlog by email
        </h2>
        <p class="mt-2 text-muted">We’ll send you our devlogs, demo news and game launches. No spam.</p>
        <div class="mt-6">
          <NewsletterForm idPrefix="contact" submitLabel="Subscribe to devlog" />
        </div>
      </div>
    </section>

    <!-- Socials -->
    <section id="follow-us" class="mt-14 border-t border-ink pt-12">
      <div class="text-center">
        <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading sm:text-3xl">Find us around</h2>
        <p class="mt-2 text-muted">We post game clips, progress updates and announcements here too.</p>
      </div>
      <ul class="mt-7 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
        {
          studio.socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="ki10-card ki10-card-interactive flex flex-col items-center justify-center p-5 text-center"
              >
                <Icon name={link.icon} class="h-9 w-9 text-primary dark:text-accent" />
                <span class="mt-2.5 text-sm font-bold text-heading">{link.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Company information (preserved from main) -->
    <section class="mt-12 border-t border-ink pt-8" aria-labelledby="company-info-title">
      <h2 id="company-info-title" class="font-heading text-lg font-extrabold text-heading">Company information</h2>
      <p class="mt-2.5 text-sm leading-relaxed text-muted">
        {studio.legalName} is a company registered in England and Wales, company number {studio.companyNumber}. For
        business enquiries, email{' '}
        <a class="font-semibold text-secondary underline" href={`mailto:${studio.businessEmail}`}>
          {studio.businessEmail}
        </a>
        .
      </p>
      <p class="mt-1.5 text-sm text-muted">Registered office: {studio.registeredOffice}</p>
      <p class="mt-1.5 text-sm text-muted">
        <a
          class="font-semibold text-secondary underline"
          href={studio.companiesHouseUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View our registered company details at Companies House
        </a>
        .
      </p>
    </section>
  </div>
</Layout>
