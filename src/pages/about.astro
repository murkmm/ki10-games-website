---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import teamTogether from '~/assets/images/team-together.webp';

const metadata = {
  title: 'About us',
  description:
    'Ki10 Games is a two-person independent studio in the UK, founded by Mark McManus and Scott Hamilton. Our goal is to sell ten copies.',
};

const timeline = [
  {
    step: '01',
    title: 'We start with KIT',
    description:
      'Our first serious project: a 3D action adventure about a kitten earning a knighthood. Nine devlogs deep we had a camera system, a quest tracker and an awful lot of grass.',
    icon: 'tabler:cat',
  },
  {
    step: '02',
    title: 'We learn to finish things',
    description:
      'KIT showed us how big a 3D adventure really is for two people, so we scoped down and picked something we could properly finish and release.',
    icon: 'tabler:bulb',
  },
  {
    step: '03',
    title: 'Skill Check ships',
    description: 'A daily gaming trivia game, out on Android and in your browser. Our first real launch.',
    icon: 'tabler:circle-check',
  },
  {
    step: '04',
    title: 'The One Bullet Job launches',
    description:
      'Our second release — a turn-based heist puzzle for Android with 120 solver-checked levels, a daily heist, and unlockable masks and outfits.',
    icon: 'tabler:target-arrow',
  },
  {
    step: '05',
    title: 'Boop n Burn & KIT in Godot',
    description:
      'A 16-player floor-is-lava party brawler heading to Steam Next Fest in February 2027, alongside bringing KIT back in Godot.',
    icon: 'tabler:flame',
  },
  {
    step: '06',
    title: 'Save File 0 for Game Boy Color',
    description:
      'A real Game Boy Color first-person survival horror ROM written in C and assembly, now our main project and heading for a physical cartridge release.',
    icon: 'tabler:device-gamepad',
  },
];

const quickFacts = [
  { label: 'Original goal', value: '10 copies' },
  { label: 'Team size', value: '2 friends' },
  { label: 'Games released', value: '2' },
  { label: 'Based in', value: 'UK' },
];
---

<Layout metadata={metadata}>
  <div class="ki10-container py-10 md:py-14">
    <header class="max-w-3xl">
      <span class="ki10-kicker">
        <Icon name="tabler:heart" class="h-4 w-4" />
        About Ki10 Games
      </span>
      <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl">
        We’re Mark and Scott.
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        Two friends making indie games in the UK. Part of why we’re called Ki10 is our original goal of just selling 10
        copies — alongside Scott’s son Kit and Mark’s two kittens.
      </p>
    </header>

    <dl class="ki10-panel mt-8 grid grid-cols-2 gap-5 p-5 sm:p-6 md:grid-cols-4">
      {
        quickFacts.map((fact) => (
          <div>
            <dt class="text-xs font-bold uppercase tracking-wider text-muted">{fact.label}</dt>
            <dd class="mt-1 font-heading text-2xl font-extrabold text-heading sm:text-3xl">{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <section class="mt-12 grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="ki10-card overflow-hidden p-2">
        <Image
          src={teamTogether}
          alt="Mark McManus and Scott Hamilton, the two people behind Ki10 Games"
          widths={[500, 900]}
          sizes="(min-width: 1024px) 540px, 100vw"
          loading="eager"
          class="w-full rounded-xl object-cover"
        />
      </div>

      <div>
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-heading">Who we are</h2>
        <p class="mt-3 leading-relaxed text-muted">
          We’ve been friends for years, and in 2024 we finally stopped talking about making games and started actually
          building them together.
        </p>

        <ul class="mt-6 divide-y divide-ink border-y border-ink">
          <li class="flex items-start gap-4 py-4">
            <span
              class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary dark:text-accent"
            >
              <Icon name="tabler:code" class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-heading text-lg font-bold text-heading">Mark McManus</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                Mark handles design, programming and QA, bringing 10+ years of games QA experience from studios like
                Supermassive Games, Creative Assembly and Unity.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-4 py-4">
            <span
              class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary dark:text-accent"
            >
              <Icon name="tabler:palette" class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-heading text-lg font-bold text-heading">Scott Hamilton</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                Our resident artist and world builder, bringing his unique art style to our characters, worlds, logos
                and UI.
              </p>
            </div>
          </li>
        </ul>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/team" class="btn-primary">
            Meet the team
            <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </a>
          <a href="/devlog-1-our-story" class="btn-secondary">Read our origin devlog</a>
        </div>
      </div>
    </section>

    <section class="mt-16 border-t border-ink pt-12">
      <div class="max-w-2xl">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-heading">The story so far</h2>
        <p class="mt-2 text-muted">How we went from our first prototype to shipping two games and building three more.</p>
      </div>

      <ol class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          timeline.map((item) => (
            <li class="ki10-card flex flex-col p-6">
              <div class="flex items-center justify-between">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/15 text-primary dark:text-accent">
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <span class="font-heading text-sm font-extrabold text-muted">{item.step}</span>
              </div>
              <h3 class="mt-4 font-heading text-lg font-bold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14">
      <div class="ki10-panel flex flex-col items-start justify-between gap-6 p-6 sm:flex-row sm:items-center sm:p-8">
        <div class="max-w-xl">
          <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading sm:text-3xl">
            Ten copies and counting
          </h2>
          <p class="mt-2 text-muted">
            Have a play of what we’ve released so far, or dig through the devlog to see how everything gets built.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/projects" class="btn-primary">
            <Icon name="tabler:device-gamepad-2" class="h-4 w-4" />
            See our games
          </a>
          <a href="/devlog" class="btn-secondary">
            <Icon name="tabler:notebook" class="h-4 w-4" />
            Read the devlog
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
