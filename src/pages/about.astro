---
import Content from '~/components/widgets/Content.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import teamTogether from '~/assets/images/team-together.webp';

const metadata = {
  title: 'About us',
  description:
    'Ki10 Games is a two person independent studio in the UK, founded by Mark McManus and Scott Hamilton. Our goal is to sell ten copies.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About Ki10 Games"
    title="We’re Mark and Scott."
    subtitle="We’re two friends making games in the UK. The original plan was to sell ten copies. That’s where Ki10 comes from."
  />

  <Content
    title="Who we are"
    subtitle="We’ve been friends for years. In 2024, we decided to have a go at making games together."
    image={{ src: teamTogether, alt: 'Mark McManus and Scott Hamilton, the two people behind Ki10 Games' }}
    items={[
      {
        title: 'Mark McManus',
        description:
          'Mark handles design, programming and QA. He’s spent over nine years testing games, and writes most of our devlogs.',
        icon: 'tabler:user-edit',
      },
      {
        title: 'Scott Hamilton',
        description:
          'The lead artist and world builder, who turns all the daft ideas into things you can actually look at.',
        icon: 'tabler:palette',
      },
    ]}
    callToAction={{ text: 'Meet the team', href: '/team', icon: 'tabler:arrow-right' }}
  />

  <Steps
    title="Where we've got to"
    tagline="The story so far"
    items={[
      {
        title: 'We start with KIT',
        description:
          'Our first serious project. A 3D action adventure about a kitten earning a knighthood, and nine devlogs deep we had a camera system, a quest tracker and an awful lot of grass.',
        icon: 'tabler:cat',
      },
      {
        title: 'We learn to finish things',
        description:
          'KIT taught us that a two person team needs to ship something before it can ship everything. So we scoped right down and picked a project we could actually get over the line.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Skill Check ships',
        description: 'A daily gaming trivia game, out on Android and the web. Our first real launch.',
        icon: 'tabler:circle-check',
      },
      {
        title: 'Boop n Burn is next',
        description:
          'A floor is lava party brawler for PC, Switch and Xbox Series, with a demo planned for Steam Next Fest in February 2027.',
        icon: 'tabler:flame',
      },
      {
        title: 'And a heist on the side',
        description:
          'The One Bullet Job, a turn based heist puzzle for phones. Small rooms, readable guards, and one bullet to get you out of trouble.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'KIT comes home',
        description:
          'Having learned how to finish things, we’re bringing KIT back and rebuilding it in Godot, starting with the mechanics and a first level.',
        icon: 'tabler:cat',
      },
    ]}
  />

  <Stats
    title="Ki10 in a few numbers"
    stats={[
      { title: 'The goal', amount: '10 copies' },
      { title: 'Focus', amount: 'Player experience' },
      { title: 'Team size', amount: '2' },
      { title: 'Games shipped', amount: '1' },
    ]}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: 'See our games', href: '/projects', icon: 'tabler:device-gamepad-2' },
      { text: 'Read the devlog', href: '/devlog', icon: 'tabler:notebook' },
    ]}
  >
    <Fragment slot="title">Ten copies and counting</Fragment>
    <Fragment slot="subtitle">
      If you fancy being one of them, our games are over here and our development notes are over there.
    </Fragment>
  </CallToAction>
</Layout>
