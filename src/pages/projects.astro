---
import Layout from '~/layouts/PageLayout.astro';
import GameCard from '~/components/games/GameCard.astro';
import { games } from '~/data/games';
const metadata = {
  title: 'Our Games',
  description:
    'Explore the games we make at Ki10: Skill Check, Boop n Burn, The One Bullet Job and KIT: Knight in Training.',
};
const released = games.filter((game) => game.status === 'released');
const developing = games.filter((game) => game.status === 'in-development');
const paused = games.filter((game) => game.status === 'on-hold');
const sections = [
  { title: 'Ready to play.', label: 'Out now', games: released, id: 'released' },
  { title: 'On the workbench.', label: 'In development', games: developing, id: 'development' },
  { title: 'On the shelf.', label: 'Paused projects', games: paused, id: 'paused' },
];
---

<Layout metadata={metadata}>
  <div class="games-page">
    <header>
      <p class="eyebrow">Made at Ki10</p>
      <h1>Our games.</h1>
      <p>A daily trivia game, a party brawler, a heist and a kitten with a sword. We’ve got a few things on the go.</p>
      <nav aria-label="Game categories">
        <a href="#released">Play something now <span aria-hidden="true">↓</span></a><a href="#development"
          >See what’s coming <span aria-hidden="true">↓</span></a>
      </nav>
    </header>
    {
      sections
        .filter((section) => section.games.length)
        .map((section) => (
          <section id={section.id} aria-labelledby={section.id + '-title'}>
            <div class="section-heading">
              <>
                <p class="eyebrow">{section.label}</p>
                <h2 id={section.id + '-title'}>{section.title}</h2>
              </>
            </div>
            <div class="game-grid">
              {section.games.map((game) => (
                <GameCard game={game} />
              ))}
            </div>
          </section>
        ))
    }
    <div class="closing">
      <h2>What have we been up to?</h2><p>
        We write about progress, problems and the occasional change of plan in our devlog.
      </p><a href="/devlog">Read the devlog <span aria-hidden="true">→</span></a>
    </div>
  </div>
</Layout>
<style>
  .games-page {
    max-width: 1280px;
    width: calc(100% - 3rem);
    margin-inline: auto;
  }
  header {
    padding-block: 3rem;
    border-bottom: 1px solid #8884;
  }
  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--aw-color-secondary);
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    font-weight: 800;
    margin: 1rem 0 1.5rem;
  }
  header > p:last-of-type {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--aw-color-text-muted);
    max-width: 62ch;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }
  nav a {
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  section {
    padding-block: 3rem;
    scroll-margin-top: 7rem;
  }
  section + section {
    border-top: 1px solid #8884;
  }
  .section-heading {
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-top: 0.5rem;
  }
  .game-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  #released .game-grid {
    max-width: 850px;
    grid-template-columns: 1fr;
  }
  #released :global(article) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  #released :global(article > div:first-child) {
    aspect-ratio: auto;
    min-width: 0;
    width: 100%;
    height: 100%;
    min-height: 280px;
  }
  .closing {
    border-top: 1px solid #8884;
    padding-block: 2.5rem;
  }
  .closing p {
    margin-block: 0.75rem 1.25rem;
    color: var(--aw-color-text-muted);
  }
  .closing a {
    color: var(--aw-color-secondary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 699px) {
    .games-page {
      width: calc(100% - 2rem);
    }
    .game-grid {
      grid-template-columns: 1fr;
    }
    #released :global(article) {
      display: flex;
    }
    #released :global(article > div:first-child) {
      aspect-ratio: 16 / 10;
      height: auto;
      min-height: 0;
    }
  }
</style>
