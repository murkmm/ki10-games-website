---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import GameCard from '~/components/games/GameCard.astro';
import { games } from '~/data/games';

const metadata = {
  title: 'Our Games',
  description:
    'Explore the games we make at Ki10: Save File 0, The One Bullet Job, Skill Check, Boop n Burn and KIT: Knight in Training.',
};

const released = games.filter((game) => game.status === 'released');
const developing = games.filter((game) => game.status === 'in-development');
const paused = games.filter((game) => game.status === 'on-hold');

const sections = [
  {
    title: 'In development',
    subtitle: 'What we are actively building right now — from Game Boy Color horror to 16-player lava brawls.',
    games: developing,
    id: 'development',
  },
  {
    title: 'Out now',
    subtitle: 'Free to pick up and play right now on Android and in your browser.',
    games: released,
    id: 'released',
  },
  {
    title: 'On hold',
    subtitle: 'Paused for now, not forgotten.',
    games: paused,
    id: 'paused',
  },
];
---

<Layout metadata={metadata}>
  <div class="ki10-container py-10 md:py-14">
    <header class="border-b border-ink pb-8 md:pb-10">
      <span class="ki10-kicker">
        <Icon name="tabler:device-gamepad-2" class="h-4 w-4" />
        Ki10 Catalogue
      </span>
      <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl">Our games</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
        Game Boy Color survival horror, a 16-player lava brawler, a pocket heist puzzle, daily gaming trivia, and a
        kitten with a sword. We don’t stick to one genre.
      </p>
      <nav aria-label="Game categories" class="mt-6 flex flex-wrap gap-3">
        <a href="#development" class="btn-primary text-sm">
          In development ({developing.length})
        </a>
        <a href="#released" class="btn-secondary text-sm">
          Out now ({released.length})
        </a>
      </nav>
    </header>

    {
      sections
        .filter((section) => section.games.length > 0)
        .map((section) => (
          <section id={section.id} aria-labelledby={`${section.id}-title`} class="border-b border-ink py-10 md:py-12">
            <div class="mb-7">
              <h2
                id={`${section.id}-title`}
                class="font-heading text-2xl font-extrabold tracking-tight text-heading sm:text-3xl"
              >
                {section.title}
              </h2>
              <p class="mt-1.5 text-sm text-muted sm:text-base">{section.subtitle}</p>
            </div>
            <div class:list={['grid gap-6', section.games.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
              {section.games.map((game, idx) => (
                <GameCard game={game} loading={section.id === 'development' && idx === 0 ? 'eager' : 'lazy'} />
              ))}
            </div>
          </section>
        ))
    }

    <section class="pt-10 md:pt-12">
      <div class="ki10-panel flex flex-col items-start justify-between gap-6 p-6 sm:flex-row sm:items-center sm:p-8">
        <div>
          <h2 class="font-heading text-2xl font-extrabold tracking-tight text-heading">
            Want to see how they get made?
          </h2>
          <p class="mt-2 max-w-xl text-muted">
            We write about progress, bugs, prototypes and changes of plan in our devlog.
          </p>
        </div>
        <a href="/devlog" class="btn-primary flex-shrink-0">
          <Icon name="tabler:notebook" class="h-4 w-4" />
          Read the devlog
        </a>
      </div>
    </section>
  </div>
</Layout>
