---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Page not found',
  robots: { index: false },
};

const suggestions = [
  { text: 'Our games', href: '/projects' },
  { text: 'The devlog', href: '/devlog' },
  { text: 'About the studio', href: '/about' },
  { text: 'Get in touch', href: '/contact' },
];
---

<Layout metadata={metadata}>
  <section class="ki10-container py-20 text-center md:py-28">
    <p class="font-heading text-7xl font-extrabold tracking-tight text-primary md:text-8xl dark:text-accent">
      <span class="sr-only">Error</span>404
    </p>

    <h1 class="mt-5 font-heading text-3xl font-extrabold tracking-tight text-heading md:text-4xl">
      This page went out of bounds.
    </h1>

    <p class="mx-auto mt-4 max-w-lg text-base text-muted sm:text-lg">
      The page you’re looking for doesn’t exist any more, or maybe never did. Here’s where everything else lives:
    </p>

    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {
        suggestions.map((item) => (
          <li>
            <a href={item.href} class="btn-secondary text-sm">
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
