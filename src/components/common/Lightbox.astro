---
import { Icon } from 'astro-icon/components';
---

<dialog
  id="ki10-lightbox"
  aria-label="Media gallery viewer"
  class="fixed inset-0 z-50 m-auto max-h-[94vh] max-w-[96vw] overflow-visible bg-transparent p-0 backdrop:bg-black/85 backdrop:backdrop-blur-sm sm:max-w-[94vw]"
>
  <div class="relative flex max-h-[92vh] max-w-[94vw] flex-col items-center justify-center sm:max-w-[92vw]">
    <div class="mb-3 flex w-full items-center justify-between gap-4 text-white">
      <span
        id="ki10-lightbox-counter"
        class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold tabular-nums"
      ></span>
      <button
        type="button"
        id="ki10-lightbox-close"
        aria-label="Close gallery"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-white transition hover:bg-white/20"
      >
        <Icon name="tabler:x" class="h-5 w-5" />
      </button>
    </div>

    <div class="relative flex items-center justify-center">
      <button
        type="button"
        id="ki10-lightbox-prev"
        aria-label="Previous item"
        class="absolute left-2 z-10 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-black/70 text-white ring-1 ring-white/20 transition hover:bg-black/90 sm:-left-14 sm:h-11 sm:w-11"
      >
        <Icon name="tabler:chevron-left" class="h-6 w-6" />
      </button>

      <img
        id="ki10-lightbox-img"
        src=""
        alt=""
        class="hidden max-h-[74vh] max-w-[92vw] rounded-xl object-contain shadow-2xl sm:max-h-[76vh] sm:max-w-[80vw]"
      />

      <video
        id="ki10-lightbox-video"
        controls
        loop
        playsinline
        class="hidden max-h-[74vh] max-w-[92vw] rounded-xl bg-black object-contain shadow-2xl sm:max-h-[76vh] sm:max-w-[80vw]"
      ></video>

      <button
        type="button"
        id="ki10-lightbox-next"
        aria-label="Next item"
        class="absolute right-2 z-10 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-black/70 text-white ring-1 ring-white/20 transition hover:bg-black/90 sm:-right-14 sm:h-11 sm:w-11"
      >
        <Icon name="tabler:chevron-right" class="h-6 w-6" />
      </button>
    </div>

    <p id="ki10-lightbox-caption" class="mt-3 max-w-2xl text-center text-sm text-white/90"></p>
  </div>
</dialog>

<script is:inline>
  (() => {
    const initLightbox = () => {
      const dialog = document.getElementById('ki10-lightbox');
      if (!dialog || dialog.dataset.ready === 'true') return;
      dialog.dataset.ready = 'true';

      const img = document.getElementById('ki10-lightbox-img');
      const video = document.getElementById('ki10-lightbox-video');
      const caption = document.getElementById('ki10-lightbox-caption');
      const counter = document.getElementById('ki10-lightbox-counter');
      const closeBtn = document.getElementById('ki10-lightbox-close');
      const prevBtn = document.getElementById('ki10-lightbox-prev');
      const nextBtn = document.getElementById('ki10-lightbox-next');

      const triggers = Array.from(document.querySelectorAll('[data-lightbox-src]'));
      if (!triggers.length || !img || !video || !caption || !counter) return;

      let currentIndex = 0;

      const stopVideo = () => {
        video.pause();
        video.removeAttribute('src');
        video.load();
      };

      const show = (index) => {
        currentIndex = (index + triggers.length) % triggers.length;
        const item = triggers[currentIndex];
        const src = item.getAttribute('data-lightbox-src') || '';
        const text = item.getAttribute('data-lightbox-caption') || '';
        const type = item.getAttribute('data-lightbox-type') || 'image';
        const isPixel = item.getAttribute('data-lightbox-pixel') === 'true';

        if (type === 'video') {
          img.classList.add('hidden');
          video.classList.remove('hidden');
          video.classList.toggle('pixel-art', isPixel);
          video.src = src;
          video.muted = false;
          video.play().catch(() => {});
        } else {
          stopVideo();
          video.classList.add('hidden');
          img.classList.remove('hidden');
          img.classList.toggle('pixel-art', isPixel);
          img.src = src;
          img.alt = text;
        }

        caption.textContent = text;
        counter.textContent = `${currentIndex + 1} / ${triggers.length}`;

        const multi = triggers.length > 1;
        if (prevBtn) prevBtn.style.display = multi ? '' : 'none';
        if (nextBtn) nextBtn.style.display = multi ? '' : 'none';
      };

      triggers.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          show(idx);
          dialog.showModal();
        });
      });

      const close = () => {
        stopVideo();
        dialog.close();
      };

      closeBtn?.addEventListener('click', close);
      prevBtn?.addEventListener('click', () => show(currentIndex - 1));
      nextBtn?.addEventListener('click', () => show(currentIndex + 1));
      dialog.addEventListener('close', stopVideo);

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(currentIndex - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(currentIndex + 1);
        }
      });
    };

    initLightbox();
    document.addEventListener('astro:after-swap', initLightbox);
  })();
</script>
