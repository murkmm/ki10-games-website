---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-flex items-center' } = Astro.props;
const urlString = String(url);
---

<div class:list={['flex flex-wrap items-center gap-2', className]}>
  <span class="text-xs font-bold uppercase tracking-wider text-muted">Share:</span>

  <button
    type="button"
    data-copy-text={urlString}
    data-copy-label="Copy link"
    data-copied-label="Copied!"
    class="inline-flex items-center gap-1.5 rounded-lg border border-ink bg-card px-2.5 py-1.5 text-xs font-semibold text-heading transition hover:border-primary hover:text-primary dark:hover:border-accent dark:hover:text-accent"
  >
    <Icon name="tabler:link" class="h-4 w-4" />
    <span data-copy-status>Copy link</span>
  </button>

  <button
    type="button"
    title="Share on Bluesky"
    aria-label="Share on Bluesky"
    data-aw-social-share="bluesky"
    data-aw-url={urlString}
    data-aw-text={text}
    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-ink bg-card text-muted transition hover:border-primary hover:text-primary dark:hover:border-accent dark:hover:text-accent"
  >
    <Icon name="tabler:brand-bluesky" class="h-4 w-4" />
  </button>

  <button
    type="button"
    title="Share on X"
    aria-label="Share on X"
    data-aw-social-share="twitter"
    data-aw-url={urlString}
    data-aw-text={text}
    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-ink bg-card text-muted transition hover:border-primary hover:text-primary dark:hover:border-accent dark:hover:text-accent"
  >
    <Icon name="tabler:brand-x" class="h-4 w-4" />
  </button>

  <button
    type="button"
    title="Share on Reddit"
    aria-label="Share on Reddit"
    data-aw-social-share="reddit"
    data-aw-url={urlString}
    data-aw-text={text}
    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-ink bg-card text-muted transition hover:border-primary hover:text-primary dark:hover:border-accent dark:hover:text-accent"
  >
    <Icon name="tabler:brand-reddit" class="h-4 w-4" />
  </button>

  <button
    type="button"
    title="Share by email"
    aria-label="Share by email"
    data-aw-social-share="mail"
    data-aw-url={urlString}
    data-aw-text={text}
    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-ink bg-card text-muted transition hover:border-primary hover:text-primary dark:hover:border-accent dark:hover:text-accent"
  >
    <Icon name="tabler:mail" class="h-4 w-4" />
  </button>
</div>
