---
import { getPermalink } from '~/utils/permalinks';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = 'text-xs', title = undefined, isCategory = false } = Astro.props;
---

{
  tags && Array.isArray(tags) && (
    <>
      {title !== undefined && (
        <span class="align-super font-normal underline decoration-2 underline-offset-4 text-muted">{title}</span>
      )}
      <ul class:list={['flex flex-wrap gap-1.5', className]}>
        {tags.map((tag) => (
          <li>
            {!APP_BLOG?.tag?.isEnabled ? (
              <span class="inline-block rounded-lg bg-subtle px-2.5 py-1 font-semibold lowercase text-muted">
                {tag.title}
              </span>
            ) : (
              <a
                href={getPermalink(tag.slug, isCategory ? 'category' : 'tag')}
                class="inline-block rounded-lg bg-subtle px-2.5 py-1 font-semibold lowercase text-muted transition hover:bg-primary/15 hover:text-secondary"
              >
                {tag.title}
              </a>
            )}
          </li>
        ))}
      </ul>
    </>
  )
}
