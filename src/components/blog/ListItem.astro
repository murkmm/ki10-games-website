---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';
import { getAuthorByName } from '~/data/authors';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const authorPage = getAuthorByName(post.author);
---

<article class={`ki10-card ki10-card-interactive group overflow-hidden grid ${image ? 'md:grid-cols-[0.9fr_1.1fr]' : ''}`}>
  {
    image &&
      (link ? (
        <a class="relative block aspect-video overflow-hidden bg-subtle md:aspect-auto md:min-h-[220px]" href={link}>
          <Image
            src={image}
            class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
            widths={[400, 900]}
            width={900}
            sizes="(max-width: 768px) 100vw, 460px"
            alt={post.title}
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <div class="relative aspect-video overflow-hidden bg-subtle md:aspect-auto md:min-h-[220px]">
          <Image
            src={image}
            class="h-full w-full object-cover"
            widths={[400, 900]}
            width={900}
            sizes="(max-width: 768px) 100vw, 460px"
            alt={post.title}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
  }
  <div class="flex flex-col p-5 sm:p-6">
    <header>
      <div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold text-muted">
        <span class="inline-flex items-center gap-1">
          <Icon name="tabler:clock" class="h-3.5 w-3.5" />
          <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        </span>
        {
          post.author && (
            <>
              <span aria-hidden="true">·</span>
              {authorPage ? (
                <a href={`/author/${authorPage.slug}`} class="hover:text-secondary hover:underline">
                  {post.author}
                </a>
              ) : (
                <span>{post.author.replaceAll('-', ' ')}</span>
              )}
            </>
          )
        }
        {
          post.readingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.readingTime} min read</span>
            </>
          )
        }
      </div>

      <h2 class="font-heading text-xl font-extrabold leading-snug tracking-tight text-heading sm:text-2xl">
        {
          link ? (
            <a class="transition group-hover:text-secondary" href={link}>
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
    </header>

    {post.excerpt && <p class="mt-2.5 flex-grow text-sm leading-relaxed text-muted sm:text-base">{post.excerpt}</p>}

    {
      post.tags && Array.isArray(post.tags) && (
        <footer class="mt-4 pt-2">
          <PostTags tags={post.tags} />
        </footer>
      )
    }
  </div>
</article>
