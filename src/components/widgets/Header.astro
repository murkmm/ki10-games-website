---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const isActive = (href?: string) => {
  if (!href) return false;
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 mx-auto w-full flex-none transition-[background-color,border-color] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative mx-auto flex w-full items-center justify-between gap-4 px-4 py-3 text-default sm:px-6',
      { 'lg:grid lg:grid-cols-[auto_1fr_auto] lg:items-center': position === 'center' },
      { 'max-w-6xl': !isFullWidth },
    ]}
  >
    <div class="flex flex-shrink-0 items-center">
      <Logo />
    </div>

    <nav
      id="main-navigation"
      class="fixed inset-x-0 bottom-0 top-[68px] z-30 hidden flex-col items-center justify-start overflow-y-auto bg-page/95 px-4 pb-10 pt-5 text-default backdrop-blur-md md:static md:inset-auto md:z-auto md:flex md:h-auto md:w-auto md:flex-row md:items-center md:justify-center md:overflow-visible md:bg-transparent md:p-0 md:backdrop-blur-none"
      aria-label="Main navigation"
    >
      <div
        class="flex w-full max-w-sm flex-col items-center gap-4 rounded-2xl border border-ink bg-card p-5 shadow-2xl md:w-auto md:max-w-none md:flex-row md:gap-0 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none"
      >
        <ul
          class="flex w-full flex-col gap-1 text-lg font-semibold md:w-auto md:flex-row md:items-center md:justify-center md:gap-0.5 md:text-sm lg:gap-1 lg:text-[0.94rem]"
        >
          {
            links.map(({ text, href, links }) => (
              <li class={links?.length ? 'dropdown w-full md:w-auto' : 'w-full md:w-auto'}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="flex w-full items-center justify-center whitespace-nowrap rounded-lg px-3 py-2.5 text-default transition hover:bg-subtle hover:text-heading md:w-auto md:justify-start md:py-2"
                    >
                      {text}{' '}
                      <Icon name="tabler:chevron-down" class="ml-0.5 hidden h-3.5 w-3.5 md:inline" />
                    </button>
                    <ul class="dropdown-menu rounded-xl border border-ink bg-card pl-4 font-medium drop-shadow-xl md:absolute md:hidden md:min-w-[200px] md:pl-0">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'block whitespace-nowrap px-4 py-2.5 first:rounded-t-xl last:rounded-b-xl hover:bg-subtle hover:text-heading',
                              { 'font-bold text-secondary': isActive(href2) },
                            ]}
                            href={href2}
                            aria-current={isActive(href2) ? 'page' : undefined}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'nav-link relative flex w-full items-center justify-center whitespace-nowrap rounded-lg px-3 py-2.5 transition hover:bg-subtle hover:text-heading md:w-auto md:justify-start md:px-2.5 md:py-2 lg:px-3.5',
                      { 'nav-link-active bg-subtle/70 text-heading md:bg-transparent': isActive(href) },
                    ]}
                    href={href}
                    aria-current={isActive(href) ? 'page' : undefined}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        <div class="mt-1 flex w-full items-center justify-between border-t border-ink pt-4 md:hidden">
          <span class="text-sm font-semibold text-muted">Appearance</span>
          <ToggleTheme />
        </div>
      </div>
    </nav>

    <div
      class="fixed bottom-0 left-0 hidden w-full items-center justify-end p-3 md:static md:mb-0 md:flex md:w-auto md:flex-shrink-0 md:self-center md:p-0"
    >
      <div class="flex w-full items-center justify-between gap-2 md:w-auto">
        <div class="flex items-center gap-1">
          {showToggleTheme && <ToggleTheme iconClass="w-5 h-5 inline-block" />}
          {
            showRssFeed && (
              <a
                class="inline-flex items-center rounded-lg p-2.5 text-sm text-muted transition hover:bg-subtle hover:text-heading"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="h-5 w-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="ml-2">
              {actions.map((btnProps) => (
                <Button {...btnProps} class="ml-2 w-auto px-5 py-2.5 text-sm font-semibold shadow-none" />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>

    <div class="flex items-center md:hidden" data-aw-toggle-menu-container>
      <ToggleMenu />
    </div>
  </div>

  <style>
    .nav-link-active::after {
      content: '';
      position: absolute;
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.25rem;
      height: 2.5px;
      border-radius: 999px;
      background-color: var(--aw-color-primary);
    }
    @media (max-width: 767px) {
      .nav-link-active {
        color: var(--aw-color-secondary);
      }
      .nav-link-active::after {
        display: none;
      }
    }
  </style>

  <style is:global>
    @media (max-width: 767px) {
      [data-aw-toggle-menu-container] {
        display: flex !important;
      }
    }
  </style>
</header>
