---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';
import NewsletterForm from '~/components/common/NewsletterForm.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'not-prose relative border-t border-ink bg-subtle/50']}>
  <div class="ki10-container py-12 md:py-14">
    <div class="grid grid-cols-12 gap-8">
      <div class="col-span-12 lg:col-span-4">
        <a
          class="inline-block font-heading text-xl font-extrabold tracking-tight text-heading"
          href={getHomePermalink()}
        >
          {SITE?.name}
        </a>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted">
          Two friends making indie games in the UK.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-muted">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? <span aria-hidden="true">·</span> : ''}
                <a class="transition hover:text-heading hover:underline" href={href} set:html={text} />
              </>
            ))
          }
        </div>
      </div>

      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="mb-3 font-heading text-sm font-bold text-heading">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="space-y-2 text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted transition hover:text-secondary hover:underline"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }

      <div id="studio-updates" class="col-span-12 md:col-span-6 lg:col-span-4" tabindex="-1">
        <div class="mb-1.5 font-heading text-sm font-bold text-heading">Get devlogs by email</div>
        <p class="mb-3 text-sm text-muted">New posts, demos and game launches. No spam.</p>
        <NewsletterForm idPrefix="footer" submitLabel="Subscribe" compact />
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-ink pt-6 md:flex-row md:items-center"
    >
      {
        socialLinks?.length ? (
          <ul class="flex flex-shrink-0 flex-wrap items-center gap-1 md:order-2">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="inline-flex items-center rounded-lg p-2.5 text-muted transition hover:bg-card hover:text-secondary"
                  aria-label={ariaLabel}
                  href={href}
                  target={href?.startsWith('http') ? '_blank' : undefined}
                  rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {icon && <Icon name={icon} class="h-5 w-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }

      <div class="text-xs leading-relaxed text-muted md:order-1">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>
