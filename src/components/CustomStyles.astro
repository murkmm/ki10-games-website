---
import '@fontsource-variable/inter';
---

<style is:inline>
  /* Light Mode Colors */
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Mono base, ember accent. Orange threads through the Ki10 kitten,
       Skill Check's badge and Boop n Burn's lava, so it carries the whole slate. */
    --aw-color-primary: rgb(194 65 12); /* Ember 700, buttons, links (4.9:1 on white) */
    --aw-color-secondary: rgb(154 52 18); /* Ember 800, taglines, button hover (6.5:1) */
    --aw-color-accent: rgb(234 88 12); /* Ember 600, decorative only */

    /* Text and Background */
    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255); /* White */
    --aw-color-bg-subtle: rgb(250 249 248);

    --aw-color-bg-page-dark: rgb(16 16 16);

    ::selection {
      background-color: rgb(255 237 213);
    }
  }

  /* Dark Mode Colors */
  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Same ember accent, tuned for contrast against the near-black page. */
    --aw-color-primary: rgb(194 65 12); /* Ember 700, white button text stays 4.9:1 */
    --aw-color-secondary: rgb(234 88 12); /* Ember 600, brighter on hover (5.9:1 on page) */
    --aw-color-accent: rgb(251 146 60); /* Ember 400, decorative only */

    /* Text and Background */
    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(16 16 16); /* Black */
    --aw-color-bg-subtle: rgb(24 24 24);

    ::selection {
      background-color: rgb(124 45 18);
      color: snow;
    }
  }

  /* --- MAILCHIMP FORM STYLES --- */
  #mc_embed_signup {
    background: transparent !important;
    font: inherit !important;
    color: inherit !important;
    width: 100%;
    max-width: 500px;
    margin: 1rem auto 0;
  }

  #mc_embed_signup form {
    padding: 0 !important;
  }

  #mc_embed_signup .mc-field-group {
    display: flex;
    gap: 0.5rem;
    width: 100% !important;
    padding: 0 !important;
  }

  #mc_embed_signup .mc-field-group input[type='email'] {
    flex-grow: 1;
    background-color: var(--aw-color-bg-page);
    color: var(--aw-color-text-default);
    border: 1px solid var(--aw-color-accent);
    border-radius: var(--aw-border-radius);
    padding: 0.75rem 1rem;
    width: 100% !important;
  }
  .dark #mc_embed_signup .mc-field-group input[type='email'] {
    background-color: rgb(22 25 37 / 66%);
  }

  #mc_embed_signup .mc-field-group input[type='submit'] {
    background-color: var(--aw-color-primary);
    color: var(--aw-color-text-default);
    font-weight: 600;
    border-radius: var(--aw-border-radius);
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--aw-color-primary);
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }
  .dark #mc_embed_signup .mc-field-group input[type='submit'] {
    color: var(--aw-color-bg-page);
  }
  #mc_embed_signup .mc-field-group input[type='submit']:hover {
    background-color: var(--aw-color-accent);
    border-color: var(--aw-color-accent);
  }

  #mc_embed_signup .content__gdpr {
    padding-top: 1rem;
    font-size: 0.875rem;
    color: var(--aw-color-text-muted);
  }

  #mc_embed_signup .gdpr-mergeRow .mc_fieldset {
    margin-top: 0.75rem;
  }

  /* NEW: Adds space above the submit button */
  #mc_embed_signup .optionalParent {
    margin-top: 1rem;
  }

  /* Hides extra Mailchimp text */
  #mc_embed_signup h2,
  #mc_embed_signup .indicates-required {
    display: none !important;
  }
</style>
