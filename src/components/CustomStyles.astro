---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/plus-jakarta-sans';
---

<style is:inline>
  /* Light Mode — Ink, Paper & Blep Magenta */
  :root {
    --aw-font-sans: 'Plus Jakarta Sans Variable';
    --aw-font-serif: 'Bricolage Grotesque Variable';
    --aw-font-heading: 'Bricolage Grotesque Variable';

    /* Pulled from the Ki10 logo: crisp ink-black & paper with the kitten's pink blep
       as the studio accent, plus arcade mint for playable / released games. */
    --aw-color-primary: rgb(209 34 106); /* Blep Berry (#d1226a), 5.05:1 with white text */
    --aw-color-secondary: rgb(168 24 83); /* Deep Berry (#a81853), 7.1:1 on paper */
    --aw-color-accent: rgb(240 90 152); /* Bright Blep Pink (#f05a98), decorative accents */
    --aw-color-mint: rgb(13 138 120); /* Arcade Mint (#0d8a78), released badges */
    --aw-color-mint-soft: rgb(230 247 244);
    --aw-color-berry-soft: rgb(253 236 243);

    /* Text, Surfaces & Borders */
    --aw-color-text-heading: rgb(20 21 26);
    --aw-color-text-default: rgb(28 29 36);
    --aw-color-text-muted: rgb(85 88 102);
    --aw-color-bg-page: rgb(250 249 245); /* Warm crisp paper (#faf9f5) */
    --aw-color-bg-subtle: rgb(241 239 231); /* Warm stone surface (#f1efe7) */
    --aw-color-bg-card: rgb(255 255 255);
    --aw-color-border: rgb(24 24 27 / 13%);
    --aw-color-border-strong: rgb(24 24 27);
    --aw-color-bg-page-dark: rgb(19 20 26);
    --aw-border-radius: 0.75rem;

    ::selection {
      background-color: rgb(253 216 232);
      color: rgb(20 21 26);
    }
  }

  /* Dark Mode — Deep Ink Charcoal & Luminous Blep Pink */
  .dark {
    --aw-font-sans: 'Plus Jakarta Sans Variable';
    --aw-font-serif: 'Bricolage Grotesque Variable';
    --aw-font-heading: 'Bricolage Grotesque Variable';

    --aw-color-primary: rgb(216 42 114); /* Vivid Berry (#d82a72), strong with white text */
    --aw-color-secondary: rgb(255 106 168); /* Luminous Blep Pink (#ff6aa8), 7.8:1 on ink */
    --aw-color-accent: rgb(255 122 178); /* Decorative pink highlight */
    --aw-color-mint: rgb(45 212 191); /* Bright Arcade Mint (#2dd4bf) */
    --aw-color-mint-soft: rgb(15 46 43);
    --aw-color-berry-soft: rgb(49 21 36);

    /* Text, Surfaces & Borders */
    --aw-color-text-heading: rgb(248 248 251);
    --aw-color-text-default: rgb(232 233 240);
    --aw-color-text-muted: rgb(169 173 189);
    --aw-color-bg-page: rgb(19 20 26); /* Deep ink charcoal (#13141a) */
    --aw-color-bg-subtle: rgb(27 29 38); /* Elevated ink (#1b1d26) */
    --aw-color-bg-card: rgb(29 31 41); /* Card ink (#1d1f29) */
    --aw-color-border: rgb(255 255 255 / 12%);
    --aw-color-border-strong: rgb(244 244 248);

    ::selection {
      background-color: rgb(168 24 83);
      color: rgb(255 255 255);
    }
  }

  /* --- MAILCHIMP FORM STYLES --- */
  .mc-signup {
    background: transparent !important;
    font: inherit !important;
    color: inherit !important;
    width: 100%;
  }

  .mc-signup form {
    padding: 0 !important;
  }

  .mc-signup h2,
  .mc-signup .indicates-required {
    display: none !important;
  }
</style>
