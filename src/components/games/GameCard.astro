---
import { Icon } from 'astro-icon/components';
import GameArt from './GameArt.astro';
import StatusBadge from './StatusBadge.astro';
import type { Game } from '~/data/games';

export interface Props {
  game: Game;
  loading?: 'eager' | 'lazy';
}

const { game, loading = 'lazy' } = Astro.props;
const href = `/projects/${game.slug}`;
---

<article
  class="game-card-item ki10-card ki10-card-interactive group relative flex h-full flex-col overflow-hidden"
  style={`--game-accent-light: ${game.accentLight}; --game-accent-dark: ${game.accentDark};`}
>
  <GameArt
    title={game.title}
    gradient={game.gradient}
    image={game.card}
    alt={`Key art for ${game.title}`}
    loading={loading}
    ratio="aspect-[16/10]"
    class="rounded-none"
  />

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <StatusBadge status={game.status} />
      <span class="text-xs font-bold uppercase tracking-wider text-muted">{game.genre}</span>
    </div>

    <h3 class="font-heading text-xl font-bold leading-snug tracking-tight text-heading">
      {/* Stretched link makes the entire card clickable without nesting interactive elements. */}
      <a href={href} class="after:absolute after:inset-0 after:content-['']">{game.title}</a>
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-muted">{game.tagline}</p>

    <div class="mt-auto flex items-center justify-between gap-3 border-t border-ink pt-4 text-xs font-semibold text-muted">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="tabler:device-gamepad-2" class="h-4 w-4 flex-shrink-0" />
        {game.platforms.join(' · ')}
      </span>
      <span class="game-card-cta inline-flex items-center gap-1 font-bold">
        {game.status === 'released' ? 'Play it' : 'Take a look'}
        <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </span>
    </div>
  </div>
</article>

<style>
  .game-card-item {
    --ki10-card-accent: var(--game-accent-light);
  }
  :global(.dark) .game-card-item {
    --ki10-card-accent: var(--game-accent-dark);
  }
  .game-card-cta {
    color: var(--ki10-card-accent);
  }
</style>
