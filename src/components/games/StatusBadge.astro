---
import { statusLabels, type GameStatus } from '~/data/games';

export interface Props {
  status: GameStatus;
  class?: string;
}

const { status, class: className = '' } = Astro.props;

const styles: Record<GameStatus, string> = {
  released: 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 ring-emerald-500/30',
  'in-development': 'bg-orange-500/15 text-orange-700 dark:text-orange-300 ring-orange-500/30',
  'on-hold': 'bg-slate-500/15 text-slate-600 dark:text-slate-300 ring-slate-500/30',
};

const dots: Record<GameStatus, string> = {
  released: 'bg-emerald-500',
  'in-development': 'bg-orange-500',
  'on-hold': 'bg-slate-400',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide ring-1 ring-inset',
    styles[status],
    className,
  ]}
>
  <span class:list={['h-1.5 w-1.5 rounded-full', dots[status]]} aria-hidden="true"></span>
  {statusLabels[status]}
</span>
