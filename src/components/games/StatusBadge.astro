---
import { statusLabels, type GameStatus } from '~/data/games';

export interface Props {
  status: GameStatus;
  class?: string;
}

const { status, class: className = '' } = Astro.props;

const styles: Record<GameStatus, string> = {
  released:
    'bg-[#e6f7f4] text-[#096b5d] ring-[#0d8a78]/30 dark:bg-[#0f2e2b] dark:text-[#5eead4] dark:ring-[#2dd4bf]/30',
  'in-development':
    'bg-[#fdecf3] text-[#a81853] ring-[#d1226a]/30 dark:bg-[#311524] dark:text-[#ff85b8] dark:ring-[#ff6aa8]/30',
  'on-hold':
    'bg-zinc-500/15 text-zinc-700 ring-zinc-500/30 dark:text-zinc-300',
};

const dots: Record<GameStatus, string> = {
  released: 'bg-[#0d8a78] dark:bg-[#2dd4bf]',
  'in-development': 'bg-[#d1226a] dark:bg-[#ff6aa8]',
  'on-hold': 'bg-zinc-400',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-bold uppercase tracking-wider ring-1 ring-inset',
    styles[status],
    className,
  ]}
>
  <span class:list={['h-1.5 w-1.5 rounded-full', dots[status]]} aria-hidden="true"></span>
  {statusLabels[status]}
</span>
