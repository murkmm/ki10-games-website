---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  gradient: string;
  image?: ImageMetadata;
  alt?: string;
  /** Tailwind aspect ratio class, e.g. "aspect-video". */
  ratio?: string;
  class?: string;
  /** Hero art should load eagerly; cards below the fold should not. */
  loading?: 'eager' | 'lazy';
  /** Renders the "art coming soon" note on the fallback panel. */
  showPlaceholderNote?: boolean;
}

const {
  title,
  gradient,
  image,
  alt,
  ratio = 'aspect-video',
  class: className = '',
  loading = 'lazy',
  showPlaceholderNote = false,
} = Astro.props;
---

<div class:list={['relative overflow-hidden rounded-xl bg-gray-900', ratio, className]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt ?? title}
        loading={loading}
        widths={[400, 900, 1400]}
        sizes="(max-width: 768px) 100vw, 900px"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <div class:list={['absolute inset-0 bg-gradient-to-br', gradient]}>
        {/* A soft vignette keeps the wordmark legible over the brightest part of the gradient. */}
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20" aria-hidden="true" />
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center">
          <span class="font-heading text-2xl font-extrabold uppercase tracking-tight text-white drop-shadow sm:text-3xl">
            {title}
          </span>
          {showPlaceholderNote && (
            <span class="rounded-full bg-black/40 px-3 py-1 text-xs font-medium uppercase tracking-widest text-white/80 backdrop-blur-sm">
              Screenshots coming soon
            </span>
          )}
        </div>
      </div>
    )
  }
</div>
